def find_map_file() -> str:
    """按优先级查找依赖映射表, 未找到返回空串 (调用方回退到内置 EMBEDDED_MAP).

    搜索顺序: $ALLTAP_MAP -> 开发目录 data/ -> ../share 安装布局 -> 用户级 -> 系统级.
    同时兼容三种安装形态: 源码目录直接跑、usr/bin + usr/share、bin + share.

    Find the dependency map by priority; return "" when none is found (caller
    falls back to EMBEDDED_MAP).

    Order: $ALLTAP_MAP -> source-tree data/ -> ../share layouts -> user -> system.
    Supports source-tree runs, usr/bin + usr/share, and bin + share installs.
    """
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in [
        os.environ.get("ALLTAP_MAP", ""),          # 显式指定
                                                   # explicit override
        os.path.join(here, "data", "dep-map.conf"), # 开发目录结构
                                                    # source-tree layout
        os.path.join(here, "..", "..", "share", "alltap", "dep-map.conf"),   # usr/bin->usr/share 结构
        # usr/bin -> usr/share layout
        os.path.join(here, "..", "share", "alltap", "dep-map.conf"),             # 单级 bin->share
        # single-level bin -> share
        os.path.expanduser("~/.local/share/alltap/dep-map.conf"),
        "/usr/share/alltap/dep-map.conf",
        "/usr/local/share/alltap/dep-map.conf",
    ]:
        if cand and os.path.exists(cand):
            return os.path.normpath(cand)
    return ""



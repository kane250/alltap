def detect_format(path: str) -> str:
    """判定输入包格式, 返回 HANDLERS 的键.

    判定优先级 (从可靠到启发式):
      1. 强 magic: RPM lead / ar 归档 -> 直接定案, 不会误判;
      2. AppImage: ELF + 文件名后缀 .AppImage (AppImage 本质是带运行时头的 ELF);
      3. 压缩流 (gzip/xz/bzip2/zstd) 或 ustar: 可能是 apk / Arch 包 / Slackware /
         普通 tarball; 先看文件名后缀, 再用 bsdtar 列首几个成员看特征:
           - .MTREE                     -> Arch 包
           - .SIGN.* / 首成员 .PKGINFO  -> Alpine apk
           - install/ 且文件名合 Slackware 规范 -> slack
      4. 剩下的归为 tarball (后续由 pkg_tarball 决定是系统树还是 /opt).

    为什么不只靠后缀: 用户经常把下载文件重命名; 为什么不只靠内容:
    apk 与 Arch 包的头部特征高度重叠, 文件名是成本最低的区分手段.

    Detect the input package format and return a HANDLERS key.

    Priority, from reliable to heuristic:
      1. strong magic: RPM lead / ar archive -> final;
      2. AppImage: ELF file named *.AppImage;
      3. compressed stream (gzip/xz/bzip2/zstd) or ustar: could be apk, Arch
         package, Slackware or a plain tarball; check the filename suffix first,
         then list the first members with bsdtar:
           - .MTREE -> Arch package
           - .SIGN.* / first member .PKGINFO -> Alpine apk
           - install/ and a Slackware-style filename -> slack
      4. everything else is a tarball (pkg_tarball decides system tree vs /opt).

    Filename matters because users rename downloads; content alone is ambiguous
    because apk and Arch packages share very similar headers.
    """
    fn = os.path.basename(path).lower()
    with open(path, "rb") as f:
        head = f.read(0x4000)      # 读 16KB 足以覆盖所有 magic 与 tar 头
                                   # 16KB is enough to cover all magic and tar headers

    # --- magic 判定优先 ---
    # --- magic-based detection first ---
    if head.startswith(b"\xed\xab\xee\xdb"):
        return "rpm"
    if head[:8] == b"!<arch>\n":
        return "deb"
    # .dtb? no. Alpine apk: gzip 流且成员名以 .PKGINFO/.SIGN 开头
    # not a .dtb. Alpine apk: a gzip stream whose members start with .PKGINFO/.SIGN
    is_gz = head[:2] == b"\x1f\x8b"
    is_xz = head[:6] == b"\xfd7zXZ\x00"
    is_bz2 = head[:3] == b"BZh"
    is_zst = head[:4] == b"\x28\xb5\x2f\xfd"

    # AppImage: ELF 且文件名 .AppImage
    # AppImage: an ELF file whose name ends with .AppImage
    if head[:4] == b"\x7fELF" and fn.endswith(".appimage"):
        return "appimage"

    # 注意: 该条件已包含未压缩 tar (ustar), 会进入本分支按内容继续判定.
    # note: this condition already includes uncompressed tar (ustar); such files enter this branch
    # and are inspected by content.
    if is_gz or is_xz or is_bz2 or is_zst or head[:8] == b"ustar  \0" or head[:8] == b"ustar\x0000":
        if fn.endswith(".apk"):
            return "apk"
        # Arch 包按文件名优先判定 (避免与 apk 的 .PKGINFO 首成员混淆)
        # Arch packages are identified by filename first (avoids confusion with apk's .PKGINFO first
        # member)
        if fn.endswith((".pkg.tar.zst", ".pkg.tar.xz", ".pkg.tar.gz", ".pkg.tar")):
            return "archpkg"
        # 看归档首条目判断类型
        # inspect the first archive members to decide the type
        names = []
        try:
            names = bsdtar_list(path)
        except Exception:
            pass
        firsts = {os.path.basename(n) for n in names[:8]}
        apk_like = any(n.startswith(".SIGN.") for n in names[:8]) or (
            ".PKGINFO" in firsts and names[:1] and names[0] == ".PKGINFO")
        arch_like = ".MTREE" in firsts or ".MTREE" in names[:3]
        if arch_like:
            return "archpkg"
        if apk_like:
            return "apk"
        if any(n.split("/")[0] == "install" for n in names) and re.search(r"-[^-]+-[^-]+-\d+\.(tgz|txz)$", fn, re.I):
            return "slack"
        # tarball: 系统树 or 普通归档
        # tarball: system tree or plain archive
        return "tarball"
    if head == b"":
        die(f"空文件: {path}")
    if fn.endswith(".appimage"):
        return "appimage"
    die(f"无法识别的包格式: {path}\n支持: .deb .rpm .apk .tgz/.txz .AppImage .tar.* .pkg.tar.zst")


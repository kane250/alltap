class Log:
    """全局日志器 (单例 log).

    三档输出刻意保持极简, 不引入 logging 模块:
      info  普通进度, -q 时静默
      verb  细节 (-verbose), 统一缩进 4 空格便于区分层级
      warn  警告, 走 stderr 且带"警告:"前缀, 不因 -q 之外的原因被吞掉

    Global logger (singleton log).

    Deliberately minimal instead of the logging module:
    info = progress (silent with -q), verb = details (--verbose, indented),
    warn = warnings on stderr with a prefix.
    """

    def __init__(self):
        self.quiet = False
        self.verbose = False

    def info(self, msg):
        if not self.quiet:
            print(msg)

    def verb(self, msg):
        # 只有显式 --verbose 才输出, 用于依赖翻译/命令回显等排查信息
        # printed only with --verbose; used for dependency translation / command echo diagnostics
        if self.verbose and not self.quiet:
            print("    " + msg)

    def warn(self, msg):
        # 警告走 stderr, 保证管道重定向 stdout 时仍能看到问题
        # warnings go to stderr so they remain visible when stdout is piped
        if not self.quiet:
            print(f"  警告: {msg}", file=sys.stderr)

    def drop_list(self, kind, items):
        """收集被丢弃/未翻译的条目, 退出前统一提示

        Collect dropped/untranslated items and report them together before exit.
        """
        if items and not self.quiet:
            print(f"  注意: 以下 {kind} 已被{ '剔除' if kind.startswith('依赖') else '忽略' }: {', '.join(sorted(set(items)))}")

log = Log()


def die(msg, code=1):
    """打印错误并立即退出.

    注意: 抛的是 SystemExit(BaseException), main() 里按文件循环的
    `except Exception` 捕获不到, 因此任何 die 都会终止整批处理.
    handler 内部对"可恢复的解析失败"应抛 ValueError 而不是 die.

    Print an error and exit immediately.

    Raises SystemExit (a BaseException), so a per-file ``except Exception`` cannot
    catch it. Recoverable parse failures inside handlers should raise ValueError
    instead of calling die().
    """
    print(f"错误: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    """执行外部命令; check=True, 非零退出码抛 CalledProcessError.

    统一 capture_output, 调用方需要输出时自己 decode (见 bsdtar_list).

    Run an external command; check=True, so a non-zero exit raises CalledProcessError.

    Output is always captured; callers decode it themselves (see bsdtar_list).
    """
    log.verb("$ " + " ".join(cmd))
    return subprocess.run(cmd, check=True, capture_output=True, text=False, **kw)


def which(cmd):
    """PATH 中是否存在可执行文件 (shutil.which 的薄封装, 便于统一替换).

    Return True when the command exists in PATH (thin wrapper around shutil.which).
    """
    return shutil.which(cmd) is not None


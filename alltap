def load_rules(path: str):
    """语法: '原名 => arch名' / '@regex re => arch名' / '@drop 名'"""
    plain, regexes, drops = {}, [], set()
    text = open(path, encoding="utf8").read() if path else EMBEDDED_MAP
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("@drop"):
            for x in line.split()[1:]:
                drops.add(x.strip("'\""))
            continue
        if line.startswith("@regex"):
            body = line[len("@regex"):].strip()
            m = re.match(r"^(.*?)\s*=>\s*(.*)$", body)
            if m:
                regexes.append((re.compile(m.group(1)), m.group(2).strip().strip("'\"")))
            continue
        m = re.match(r"^(\S+)\s*(?:=>\s*(\S*))$", line)
        if m:
            plain[m.group(1)] = (m.group(2) or "").strip()
    return plain, regexes, drops


ARCH_REPOS_CACHE = None

def arch_repo_names() -> set:
    """当前系统仓库里全部包名 (pacman -Slq)"""
    global ARCH_REPOS_CACHE
    if ARCH_REPOS_CACHE is not None:
        return ARCH_REPOS_CACHE
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                         "alltap", "arch-repo-names.txt")
    names = set()
    try:
        if os.path.exists(cache) and time.time() - os.path.getmtime(cache) < 7 * 86400:
            names = set(open(cache).read().split())
        elif which("pacman"):
            out = subprocess.run(["pacman", "-Slq"], capture_output=True, text=True)
            if out.returncode == 0:
                names = set(out.stdout.split())
                os.makedirs(os.path.dirname(cache), exist_ok=True)
                open(cache, "w").write("\n".join(sorted(names)))
    except Exception as e:
        log.verb(f"获取 Arch 仓库包名失败: {e}")
    ARCH_REPOS_CACHE = names
    return names


class Translator:
    def __init__(self, opts):
        self.opts = opts
        mfile = find_map_file()
        self.plain, self.regexes, self.drops = load_rules(mfile)
        if not mfile:
            log.verb("使用内嵌最小映射表 (未找到 data/dep-map.conf)")
        self.repo = arch_repo_names()
        self.unresolved = []
        self.droplog = []
        self.translated = []

    # ---- 规则链 ----
    def _lookup(self, name: str) -> Optional[str]:
        # 1. 显式映射
        if name in self.plain:
            return self.plain[name] or None    # 空值 = 丢弃
        if name in self.drops:
            return None
        # 2. 正则
        for rx, dest in self.regexes:
            if rx.match(name):
                return dest or None
        # 3. 直接与 Arch 仓库同名
        if name in self.repo:
            return name
        # 4. lib 前缀/soname 后缀变形
        cands = []
        m = re.match(r"^(lib[^-]+?)[0-9]+([.][0-9.]+)?([-+].*)?$", name)
        if m:
            base = m.group(1)
            cands += [base]
        m2 = re.match(r"^(lib)?(.+?)(-dev|-devel|-doc|-docs|-common|-bin)?$", name)
        if m2:
            core = m2.group(2)
            if m2.group(3) == "-dev" or m2.group(3) == "-devel":
                cands += [core, m2.group(1) + core if m2.group(1) else core]
            else:
                cands += [core]
        # soname: libfoo.so.5
        m3 = re.match(r"^(lib[^.]+)\.so(\.[0-9.]+)?$", name)
        if m3:
            lib = m3.group(1)
            cands = [lib, lib[3:] if lib.startswith("lib") else lib] + cands
        for c in cands:
            if not c or len(c) <= 2:
                continue
            if c in self.plain:
                return self.plain[c] or None
            if c in self.repo:
                return c
            # 再试 去 lib
            if c.startswith("lib") and len(c) > 5:
                c2 = c[3:]
                if c2 in self.plain:
                    return self.plain[c2] or None
                if c2 in self.repo:
                    return c2
        return None

    def translate(self, dep: Dep, ctx: str) -> Dep:
        """翻译单条依赖; 无法翻译时按 --keep-unknown-deps 决定去留"""
        name = dep.name
        if name in self.drops:
            self.droplog.append(name)
            return None
        if ctx == "deb" and name in DEB_TRASH:
            self.droplog.append(name)
            return None
        newname = self._lookup(name)
        if newname:
            nd = Dep(newname, dep.op, dep.ver)
            if newname != name:
                self.translated.append(f"{name}->{newname}")
            else:
                self.translated.append(f"{name}(同名直用)")
            return nd
        # 去留由 opts.keep_unknown_deps 决定, 记录里只保留原始依赖名,
        # 避免输出与报告出现 "(保留原样)" 之类的重复注解
        self.unresolved.append(name)
        return dep if self.opts.keep_unknown_deps else None

    def reset(self):
        self.unresolved = []
        self.droplog = []
        self.translated = []


# 各源依赖的"垃圾名单"
RPM_GARBAGE = [
    re.compile(r"^rpmlib\(.*"), re.compile(r"^rtld\([^)]*\)$"),
    re.compile(r"^config\([^)]*\)$"), re.compile(r"^/.*"),           # /bin/sh 等
    re.compile(r".*\.so(\.[0-9]+)*(\([^)]*\))*$"),       # soname 含 GLIBC 版本标记/64bit
    re.compile(r"^objfmt\("), re.compile(r"^elf\("),
    re.compile(r"^python\(abi\)"), re.compile(r"^perl\("), re.compile(r"^ruby\("),
    re.compile(r"^bundled\("), re.compile(r"^debuginfod\("),
    re.compile(r"^[A-Za-z0-9._+-]+\((x86-64|x86|aarch64|i686|ppc64le|s390x|riscv64)\)$"),  # 架构虚拟 provides
]

DEB_TRASH = {  # 这些是发行版基础设施包, Arch 无对应概念, deb 特有丢弃集
    "debconf", "debconf-2.0", "dpkg", "install-info", "libc-bin", "init-system-helpers",
    "base-files", "adduser", "usr-is-merged", "coreutils", "bash", "dash", "mount",
    "passwd", "passwd:", "libsasl2-modules", "systemd-sysv", "sysvinit-utils",
    "lsb-base", "libgcc-12-base", "libgcc-s1", "gcc-12-base", "gcc-13-base",
    "ucf", "mime-support", "media-types", "x11-common", "shared-mime-info",
}

APK_TRASH_RE = [
    re.compile(r"^so:.*"), re.compile(r"^cmd:.*"),
]


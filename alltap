# 各格式 handler: 返回 (Metadata, tree_dir, workdir)
# per-format handlers: return (Metadata, tree_dir, workdir)
# ---------------------------------------------------------------------------

def pkg_deb(path: str, opts) -> Tuple[Metadata, str, str]:
    """解析 Debian 包 (.deb).

    .deb 是一个 ar 归档, 典型成员:
      debian-binary     版本号 "2.0\\n"
      control.tar.{gz,xz,zst}   control / md5sums / conffiles / preinst... 等脚本
      data.tar.{gz,xz,zst}      实际文件树
    流程: ar 解出两个 tar -> bsdtar 各自解包 -> 读 control 填 Metadata ->
    把 dpkg 的维护脚本翻译成 .INSTALL 函数 (用 `set -- <dpkg参数>` 模拟 $1).
    返回 (Metadata, 文件树目录, 临时工作目录).

    Parse a Debian package (.deb).

    A .deb is an ar archive with members: debian-binary, control.tar.{gz,xz,zst}
    (control, md5sums, conffiles, preinst...) and data.tar.{gz,xz,zst}.
    Flow: ar -> two tars -> bsdtar extract -> read control into Metadata ->
    translate dpkg maintainer scripts into .INSTALL functions (using
    ``set -- <dpkg arg>`` to emulate $1). Returns (Metadata, file tree, temp dir).
    """
    members = parse_ar(path)
    ctrl_name = next((n for n, _ in members if n.startswith("control.tar.")), None)
    data_name = next((n for n, _ in members if n.startswith("data.tar.")), None)
    if not ctrl_name or not data_name:
        die(f"deb 内缺少 control/data 成员: {path}")

    work = tempfile.mkdtemp(prefix="alltap-deb-")
    ctrl_arch = os.path.join(work, "control.tar")
    data_arch = os.path.join(work, "data.tar")
    # 先落盘成独立 tar, 交给 bsdtar 处理压缩格式差异 (gz/xz/zst 自动识别)
    # write each member to a standalone tar first; bsdtar then handles the compression differences
    # (gz/xz/zst auto-detected)
    open(ctrl_arch, "wb").write(dict(members)[ctrl_name])
    open(data_arch, "wb").write(dict(members)[data_name])

    cdir = os.path.join(work, "control")
    fdir = os.path.join(work, "files")
    bsdtar_extract(ctrl_arch, cdir)
    bsdtar_extract(data_arch, fdir)

    ctrl_files = []
    for root, _, files in os.walk(cdir):
        for fn in files:
            ctrl_files.append(os.path.relpath(os.path.join(root, fn), cdir))
    ctrl_path = next((c for c in ctrl_files if c.endswith("control")), None)
    if not ctrl_path:
        die("deb control 成员中没有 control 文件")
    fields = parse_deb_control(open(os.path.join(cdir, ctrl_path), encoding="utf8", errors="replace").read())

    meta = Metadata(source_fmt="deb")
    meta.name = sanitize_pkgname(fields.get("Package", "pkg"))
    epoch, ver, rel = split_deb_version(fields.get("Version", "1.0-1"))
    meta.epoch, meta.version, meta.release = epoch, sanitize_ver(ver), sanitize_rel(rel)
    desc_lines = fields.get("Description", "").splitlines()
    meta.desc = (desc_lines[0] if desc_lines else "(无描述)").strip() or "(无描述)"
    meta.long_desc = "\n".join(l for l in desc_lines[1:] if l.strip() != ".").strip()
    meta.arch = map_arch(fields.get("Architecture", ""), "deb")
    meta.url = fields.get("Homepage", "").strip()
    meta.license = "unknown"

    tr = opts.translator  # type: Translator

    # Depends / Pre-Depends → depends
    # deb 的 "a | b" 是"或"关系: 依次尝试翻译, 采用第一个能识别的结果;
    # 若全部失败且开启了 -k, 则保留第一个原始备选名.
    # Depends / Pre-Depends -> depends
    # deb's "a | b" means OR: try the alternatives in order and take the first translatable one;
    # if all fail and -k is enabled, keep the first original alternative.
    for key in ("Depends", "Pre-Depends"):
        groups = parse_deb_dep_string(fields.get(key, ""))
        for alts in groups:
            chosen = None
            for a in alts:                # alternative 取第一个能翻译成功的
                                          # alternative: take the first one that translates successfully
                nd = tr.translate(a, "deb")
                if nd:
                    chosen = nd
                    break
            if chosen:
                meta.depends.append(chosen)
            elif opts.keep_unknown_deps and alts:
                meta.depends.append(alts[0])

    # Recommends → optdepends
    # deb 的 Recommends 是弱依赖, 对应 Arch 的 optdepends;
    # 同样只取第一个备选 (pacman 的 optdepends 不支持"或"语法).
    # Recommends -> optdepends
    # deb Recommends is a weak dependency and maps to Arch optdepends;
    # likewise only the first alternative is taken (pacman optdepends has no OR syntax).
    for alts in parse_deb_dep_string(fields.get("Recommends", "")):
        if not alts:
            continue
        d = alts[0]
        meta.optdepends.append(f"{d.name}: (由 Recommends 转换, 可选)")

    # Provides / Conflicts / Breaks / Replaces (未识别的保留原名, 不计入依赖报告)
    # 这些字段不是"安装依赖", 用 _lookup 而非 translate(), 避免污染依赖报告.
    # Provides / Conflicts / Breaks / Replaces (unknown names kept as-is; not counted in the
    # dependency report)
    # these fields are not install dependencies; use _lookup instead of translate() to keep the
    # dependency report clean.
    for alts in parse_deb_dep_string(fields.get("Provides", "")):
        d = alts[0]
        nm = tr._lookup(d.name) or d.name
        meta.provides.append(d.to_pacman() if d.op else nm)
    for alts in (parse_deb_dep_string(fields.get("Conflicts", "")) +
                 parse_deb_dep_string(fields.get("Breaks", ""))):
        d = alts[0]
        nm = tr._lookup(d.name) or d.name
        meta.conflicts.append(Dep(nm, d.op, d.ver).to_pacman() if d.op else nm)
    for alts in parse_deb_dep_string(fields.get("Replaces", "")):
        d = alts[0]
        meta.replaces.append(d.name)

    # 维护脚本 → .INSTALL (deb 参数语义模拟)
    # dpkg 向脚本传 $1 (install/upgrade/remove/configure), pacman 传的是
    # $1=1(安装) / 2(升级) / 0(卸载). 用 `set -- <值>` 预置位置参数,
    # 让原脚本里 `case "$1" in configure)` 这类判断尽量能跑通 — 属近似翻译.
    # 局限: prerm/postrm 在升级场景也会被 dpkg 调用, 此处只映射到 *_remove.
    # maintenance scripts -> .INSTALL (simulating deb argument semantics)
    # dpkg passes $1 (install/upgrade/remove/configure) to scripts, while pacman passes
    # $1=1 (install) / 2 (upgrade) / 0 (remove). `set -- <value>` pre-seeds the positional
    # parameters,
    # so that checks like `case "$1" in configure)` in the original script still work — an
    # approximation.
    # limitation: dpkg also calls prerm/postrm on upgrades, but here they only map to *_remove.
    script_map = {
        "preinst":  [("pre_install", "install"), ("pre_upgrade", "upgrade")],
        "postinst": [("post_install", "configure"), ("post_upgrade", "configure")],
        "prerm":    [("pre_remove", "remove")],
        "postrm":   [("post_remove", "remove")],
    }
    if not opts.no_scripts:
        for sname, targets in script_map.items():
            spath = find_script(cdir, sname)
            if not spath:
                continue
            body = read_script(spath)
            if body is None:
                continue
            for fname, arg in targets:
                meta.scripts[fname] = f"set -- {arg}\n{body}"
    return meta, fdir, work


MAP_ARCH = {
    # deb
    "amd64": "x86_64", "i386": "i686", "i486": "i686", "i586": "i686", "i686": "i686",
    "arm64": "aarch64", "aarch64": "aarch64", "armhf": "armv7h", "armel": "arm",
    "riscv64": "riscv64", "loong64": "loongarch64", "ppc64el": "ppc64le", "s390x": "s390x",
    "mips64el": "mips64el", "all": "any", "any": "any", "linux-any": "any", "noarch": "any",
    # alpine
    "x86": "i686", "armv7": "armv7h", "armhf_musl": "armv7h",
    # slack
    # ia64 (Itanium) 在 Arch 没有对应架构, 不做臆测映射, 留给 map_arch 告警
    # ia64 (Itanium) has no Arch counterpart; do not guess a mapping, let map_arch warn
}

# Arch 侧认可的架构集合 = 映射值 ∪ {any}
# architectures accepted by Arch = mapped values ∪ {any}
KNOWN_ARCH = set(MAP_ARCH.values()) | {"any"}


def map_arch(a: str, src: str) -> str:
    """把源发行版架构名映射到 Arch 架构名.

    未知架构会告警并回退到 x86_64 (而不是静默仿造一个不存在的架构);
    需要时可用 -a 显式覆盖. src 参数保留为后续按格式细分映射的入口.

    Map a source-distro architecture name to an Arch architecture name.

    Unknown architectures trigger a warning and fall back to x86_64 (rather than
    silently inventing an unsupported arch); override with -a. The src parameter
    is reserved for future per-format refinements.
    """
    a = a.strip().lower()
    if not a:
        return "any"
    if a in MAP_ARCH:
        return MAP_ARCH[a]
    if a in KNOWN_ARCH:
        return a
    log.warn(f"未知架构 {a!r}, 按 x86_64 处理 (可用 -a 覆盖)")
    return "x86_64"


def split_deb_version(v: str):
    """拆 "[epoch:]version[-revision]" -> (epoch, version, revision).

    以最后一个 '-' 分割 (版本本身可能含 '-', 但 deb 规范要求 revision 在最后);
    无 revision 时给 "1" (与大多数 Arch 包的 pkgrel 习惯一致).
    '~' 是 deb 的预发布标记 (排序低于空串), pacman 不认, 统一换成 '_';
    '+' 同样不在 pkgrel 允许字符内. 注意这里只做字符集清洗, 真正的
    pkgrel 规范化由 sanitize_rel 完成.

    Split "[epoch:]version[-revision]" -> (epoch, version, revision).

    Split on the last '-' (the revision is last per deb policy); default revision
    is "1". '~' is deb's pre-release marker and '+' is not allowed in pkgrel, so
    both are replaced; sanitize_rel performs the final pkgrel normalization.
    """
    v = v.strip()
    epoch = ""
    m = re.match(r"^(\d+):(.*)$", v)
    if m:
        epoch, v = m.group(1), m.group(2)
    if "-" in v:
        ver, rel = v.rsplit("-", 1)
    else:
        ver, rel = v, "1"
    ver = re.sub(r"[~]", "_", ver)
    rel = re.sub(r"[~+]", "_", rel)
    return epoch, ver, rel


# deb 的比较符与 pacman 基本一一对应, 只有 << / >> 需换成 < / >
# deb comparison operators map almost one-to-one to pacman; only << / >> become < / >
DEB_OP = {"<<": "<", "<=": "<=", "=": "=", ">=": ">=", ">>": ">", ">": ">", "<": "<"}


def parse_deb_dep_string(s: str):
    """解析 deb 依赖字段 -> [[Dep, ...](同一组的多个备选), ...].

    语法: 逗号分隔组, 组内 '|' 分隔备选, 每项可带架构限定 ':any/:native'
    与版本约束 '(>= 1.2)'. 正则未做全串匹配, 未识别的尾部细节会被忽略.
    返回的是"组"的列表而不是扁平列表, 因为 'a | b' 的选择逻辑需要知道分组.

    Parse a deb dependency field -> [[Dep, ...] (alternatives in one group), ...].

    Syntax: comma-separated groups, '|' separates alternatives, each item may carry
    an architecture qualifier (:any/:native) and a version constraint (>= 1.2).
    The regex is not anchored at the end, so unrecognized trailing details are
    ignored. Groups are preserved because 'a | b' selection needs them.
    """
    out = []
    if not s:
        return out
    for grp in s.split(","):
        grp = grp.strip()
        if not grp:
            continue
        alts = []
        for item in grp.split("|"):
            item = item.strip()
            if not item:
                continue
            m = re.match(r"^([A-Za-z0-9][^()\[\s:]*)(?::(any|native))?\s*(\(\s*(<<|<=|=|>=|>>)\s*([^)]+)\s*\))?", item)
            if not m:
                continue
            name = m.group(1)
            op = ver = None
            if m.group(4):
                op, ver = DEB_OP.get(m.group(4), m.group(4)), m.group(5).strip()
            alts.append(Dep(name, op, ver))
        if alts:
            out.append(alts)
    return out


def find_script(d: str, sname: str):
    """在 control 目录里找维护脚本 (允许存在 './' 前缀或子目录).

    control.tar 成员名在不同打包器下可能是 './postinst'、'postinst' 或
    'control/postinst', 因此用后缀匹配而不是精确路径. 找不到返回 None.

    Find a maintainer script in the control directory (allowing './' or subdirs).

    Member names vary between packers: './postinst', 'postinst' or
    'control/postinst'. Suffix matching handles all of them; returns None if absent.
    """
    for root, _, files in os.walk(d):
        for fn in files:
            rel = os.path.relpath(os.path.join(root, fn), d)
            if rel == sname or rel.endswith("/" + sname) or rel == "./" + sname:
                return os.path.join(root, fn)
    return None


def read_script(path: str, strip_shebang=True):
    """读维护脚本正文; 默认去掉 shebang 行.

    为什么要去 shebang: .INSTALL 里的函数体由 pacman 用 /bin/bash 执行,
    原脚本的 '#!/bin/sh' 会被当成普通注释/命令行, 保留反而可能误导.
    读失败返回 None (调用方跳过该脚本), 不抛异常以免中断整个转换.

    Read a maintainer script body; the shebang line is removed by default.

    Why: .INSTALL functions are executed by pacman with /bin/bash, and the original
    '#!/bin/sh' would just be a misleading comment/command. Returns None on read
    failure so the caller can skip that script instead of aborting the conversion.
    """
    try:
        txt = open(path, encoding="utf8", errors="replace").read()
    except OSError:
        return None
    lines = txt.splitlines()
    if strip_shebang and lines and lines[0].startswith("#!"):
        lines = lines[1:]
    return "\n".join(lines).strip()


def rpm_dep_triplet(rpm: RpmInfo, ntag, ftag, vtag):
    """把 rpm 的三张平行数组 (名字/标志/版本) 拉平成 [(name, flags, ver), ...].

    rpm header 里依赖是三个等长数组, 按 index 对应; 某数组短时用默认值补齐
    (flags=0 表示无约束, ver=""), 避免畸形包直接抛 IndexError.

    Flatten rpm's three parallel arrays (names/flags/versions) into
    [(name, flags, ver), ...].

    Missing array elements use defaults (flags=0 means unversioned, ver="") to avoid
    IndexError on malformed packages.
    """
    names = rpm.f.get(T[ntag], []) or []
    flags = rpm.f.get(T[ftag], []) or []
    vers = rpm.f.get(T[vtag], []) or []
    out = []
    for i, nm in enumerate(names):
        fl = flags[i] if i < len(flags) else 0
        vv = vers[i] if i < len(vers) else ""
        out.append((nm, fl, vv))
    return out


def pkg_rpm(path: str, opts) -> Tuple[Metadata, str, str]:
    """解析 RPM 包 -> (Metadata, 文件树, 临时目录).

    RPM 的字段类型比较杂 (STRING / STRING_ARRAY / I18NSTRING / INT32),
    同一 tag 在不同包中可能是 str 也可能是 list, 所以取值处统一做了"摸平":
    EPOCH/SUMMARY/DESCRIPTION 都按 list-or-str 两种形态处理.

    依赖处理原则:
      * Requires 里的虚拟能力与 soname 全部丢弃 (RPM_GARBAGE), 因为 Arch
        不用 soname 做包依赖, 保留只会造出永远无法满足的假依赖;
      * 真正剩下的包名走 Translator 翻译, 失败时由 -k 策略决定去留.
    脚本部分只处理 prein/postin/preun/postun; pre/posttrans 在 pacman 中
    没有对应钩子, 仅提醒用户.

    Parse an RPM package -> (Metadata, file tree, temp dir).

    RPM tag types vary (STRING / STRING_ARRAY / I18NSTRING / INT32) and the same tag
    may be a str or a list depending on the package, so EPOCH/SUMMARY/DESCRIPTION
    are normalized at read time.

    Dependency policy:
      * virtual capabilities and sonames in Requires are dropped (RPM_GARBAGE),
        because Arch tracks package names, not sonames;
      * remaining package names go through Translator; -k decides the fate of
        unresolved ones.
    Scriptlets handle prein/postin/preun/postun only; pre/posttrans have no pacman
    hook and are reported to the user.
    """
    try:
        rpm = parse_rpm(path)
    except ValueError as e:
        raise ValueError(f"RPM 解析失败: {e}")

    work = tempfile.mkdtemp(prefix="alltap-rpm-")
    fdir = os.path.join(work, "files")
    n = rpm.payload_to(fdir)
    log.verb(f"RPM payload ({rpm.compressor}) 解出 {n} 条目")

    meta = Metadata(source_fmt="rpm")
    name = rpm.f.get(T["NAME"], "pkg")
    meta.name = sanitize_pkgname(name)
    rel = rpm.f.get(T["RELEASE"], "1")
    vr = rpm.f.get(T["VERSION"], "1.0")
    ep = rpm.f.get(T["EPOCH"], None)
    if isinstance(ep, list):
        ep = str(ep[0]) if ep else ""
    meta.epoch = ep or ""
    mrel = re.match(r"^(\d+)", rel)
    meta.version = sanitize_ver(vr)
    meta.release = mrel.group(1) if mrel else sanitize_rel(rel)
    summary = rpm.f.get(T["SUMMARY"], []) or "(无描述)"
    if isinstance(summary, list):
        summary = summary[0] if summary else ""
    meta.desc = summary.strip() or "(无描述)"
    desc = rpm.f.get(T["DESCRIPTION"], "") or ""
    meta.long_desc = desc.strip() if isinstance(desc, str) else desc[0] if desc else ""
    meta.arch = map_arch(rpm.f.get(T["ARCH"], "x86_64"), "rpm")
    meta.url = rpm.f.get(T["URL"], "") or ""
    # LICENSE 可能是 "MIT AND GPL-2.0-or-later" 这类复合表达式:
    # 按 AND/OR 拆开逐项归一化, 去重后重新拼成空格分隔的列表
    # (write_pkginfo 会再拆成多行 license = ...).
    # LICENSE may be a compound expression such as "MIT AND GPL-2.0-or-later":
    # split on AND/OR, normalize each item, deduplicate, then join with spaces
    # (write_pkginfo splits it again into multiple license = lines).
    lic_raw = rpm.f.get(T["LICENSE"], "") or "unknown"
    parts = [p.strip() for p in re.split(r"\s+(?:AND|OR|and|or)\s+", lic_raw) if p.strip() and p.strip() not in ("(", ")", "AND", "OR")]
    lic_out = []
    for p in parts:
        v = sanitize_license(p)
        if v and v not in lic_out:
            lic_out.append(v)
    meta.license = " ".join(lic_out) or "unknown"

    tr = opts.translator

    # Requires
    # 先过滤虚拟能力/soname (见 RPM_GARBAGE), 剩下的才是真正的包名依赖.
    # filter out virtual capabilities/sonames first (see RPM_GARBAGE); what remains are real package
    # dependencies.
    for nm, fl, vv in rpm_dep_triplet(rpm, "REQUIRENAME", "REQUIREFLAGS", "REQUIREVERSION"):
        if is_rpm_virtual(nm):
            log.verb(f"丢弃 RPM 虚拟/soname 依赖: {nm}")
            tr.droplog.append(nm)
            continue
        d = Dep(nm, rpm_sense_to_op(fl), vv.strip() or None)
        nd = tr.translate(d, "rpm")
        if nd:
            meta.depends.append(nd)

    # Recommends (weak) → optdepends
    # Recommends (weak) -> optdepends
    for nm, fl, vv in rpm_dep_triplet(rpm, "RECOMMENDNAME", "RECOMMENDFLAGS", "RECOMMENDVERSION"):
        if not is_rpm_virtual(nm):
            meta.optdepends.append(f"{nm}: (由 Recommends 转换, 可选)")

    # Provides (未识别保留原名, 不计入依赖报告)
    # Provides (unknown names are kept as-is; not counted in the dependency report)
    for nm, fl, vv in rpm_dep_triplet(rpm, "PROVIDENAME", "PROVIDEFLAGS", "PROVIDEVERSION"):
        if is_rpm_virtual(nm):
            continue
        op = rpm_sense_to_op(fl)
        meta.provides.append(Dep(nm, op, vv).to_pacman() if op and vv else nm)

    # Conflicts / Obsoletes
    for nm, fl, vv in rpm_dep_triplet(rpm, "CONFLICTNAME", "CONFLICTFLAGS", "CONFLICTVERSION"):
        if is_rpm_virtual(nm):
            continue
        meta.conflicts.append(Dep(nm, rpm_sense_to_op(fl), vv).to_pacman())
    for nm, fl, vv in rpm_dep_triplet(rpm, "OBSOLETENAME", "OBSOLETEFLAGS", "OBSOLETEVERSION"):
        if is_rpm_virtual(nm):
            continue
        meta.replaces.append(nm)

    # scriptlets
    # RPM 的 scriptlet 通过 POSTINPROG 声明解释器; 若解释器是 ldconfig,
    # 说明该包需要刷新动态链接器缓存 — 这在 Arch 上同样必须做.
    # pacman 不调用 ldconfig, 因此需要手动追加到 post_install/post_upgrade.
    # RPM scriptlets declare their interpreter via POSTINPROG; if the interpreter is ldconfig,
    # it means the package needs the dynamic linker cache refreshed — also required on Arch.
    # pacman does not call ldconfig, so it must be appended manually to post_install/post_upgrade.
    if not opts.no_scripts:
        prog = rpm.f.get(T["POSTINPROG"], "")
        ldconfig = False
        if isinstance(prog, list):
            ldconfig = any(p.endswith("ldconfig") for p in prog if p)
        postin = rpm.f.get(T["POSTIN"], "") or ""
        postin = postin[0] if isinstance(postin, list) and postin else postin
        prein = rpm.f.get(T["PREIN"], "") or ""
        prein = prein[0] if isinstance(prein, list) and prein else prein
        preun = rpm.f.get(T["PREUN"], "") or ""
        preun = preun[0] if isinstance(preun, list) and preun else preun
        postun = rpm.f.get(T["POSTUN"], "") or ""
        postun = postun[0] if isinstance(postun, list) and postun else postun
        if postin.strip():
            meta.scripts["post_install"] = f"set -- 1\n{postin.strip()}"
            meta.scripts["post_upgrade"] = f"set -- 2\n{postin.strip()}"
            if ldconfig:
                for k in ("post_install", "post_upgrade"):
                    meta.scripts[k] += "\nldconfig"
        elif ldconfig:
            meta.scripts["post_install"] = "ldconfig"
            meta.scripts["post_upgrade"] = "ldconfig"
        if prein.strip():
            meta.scripts["pre_install"] = f"set -- 1\n{prein.strip()}"
            meta.scripts["pre_upgrade"] = f"set -- 2\n{prein.strip()}"
        if preun.strip():
            meta.scripts["pre_remove"] = f"set -- 0\n{preun.strip()}"
        if postun.strip():
            meta.scripts["post_remove"] = f"set -- 0\n{postun.strip()}"
        pretr = rpm.f.get(T["PRETRANS"], "")
        posttr = rpm.f.get(T["POSTTRANS"], "")
        if (pretr and pretr.strip()) or (posttr and posttr.strip()):
            log.warn("RPM 的 pre/posttrans 脚本在 pacman 中无直接对应, 已忽略")
    return meta, fdir, work


def is_rpm_virtual(nm: str) -> bool:
    """判断是否是 rpm 虚拟能力/soname/路径类依赖 (不应出现在 Arch depends 中).

    Return True for rpm virtual capabilities/sonames/path dependencies that must
    not appear in Arch depends.
    """
    for rx in RPM_GARBAGE:
        if rx.match(nm):
            return True
    return False


def sanitize_license(l: str) -> str:
    """把源发行版的许可证写法归一到 Arch 常见简称.

    分三步: 查别名表 -> 过长 (>24 字符) 且无别名则标 custom
    -> 否则剔除非 [A-Za-z0-9.+-] 字符. 返回单token字符串,
    多许可证的合并由调用方 (pkg_rpm) 负责.

    Normalize a source-distro license string to a common Arch short name.

    Three steps: alias table -> strings longer than 24 chars without an alias become
    "custom" -> otherwise strip characters outside [A-Za-z0-9.+-]. Returns a single
    token; pkg_rpm merges multiple licenses.
    """
    l = l.strip()
    if not l:
        return "unknown"
    # 常见别名归并
    # merge common license aliases
    aliases = {
        # 传统写法
        # traditional spelling
        "GPLv2": "GPL2", "GPLv2+": "GPL", "GPLv3": "GPL3", "GPLv3+": "GPL",
        "GPL": "GPL", "LGPLv2": "LGPL", "LGPLv2+": "LGPL",
        "LGPLv3": "LGPL", "MIT": "MIT", "BSD": "BSD", "BSD-2-Clause": "BSD",
        "BSD-3-Clause": "BSD", "ASL 2.0": "Apache", "Apache-2.0": "Apache",
        "ISC": "ISC", "MPLv1.1": "MPL", "MPLv2.0": "MPL", "Python": "Python",
        "Public Domain": "public-domain", "unknown": "unknown",
        # SPDX 写法 (新 rpm/Fedora 默认)
        # SPDX style (default in newer rpm/Fedora)
        "GPL-2.0-only": "GPL2", "GPL-2.0-or-later": "GPL",
        "GPL-2.0-or-newer": "GPL", "GPL-2+": "GPL",
        "GPL-3.0-only": "GPL3", "GPL-3.0-or-later": "GPL",
        "GPL-3.0-or-newer": "GPL", "GPL-3+": "GPL",
        "LGPL-2.0-only": "LGPL", "LGPL-2.0-or-later": "LGPL",
        "LGPL-2.1-only": "LGPL", "LGPL-2.1-or-later": "LGPL",
        "LGPL-3.0-only": "LGPL", "LGPL-3.0-or-later": "LGPL",
        "LGPL-2.1+": "LGPL", "LGPL-3+": "LGPL",
        "BSD-2-Clause-FreeBSD": "BSD", "Apache-2.0": "Apache",
        "MPL-1.1": "MPL", "MPL-2.0": "MPL", "PSF-2.0": "Python",
        "Zlib": "ZLIB", "BSL-1.0": "Boost", "CDDL-1.0": "CDDL",
        "Artistic-1.0-Perl": "PerlArtistic", "Artistic-2.0": "Artistic2.0",
    }
    v = aliases.get(l)
    if v:
        return v
    return "custom" if len(l) > 24 else re.sub(r"[^A-Za-z0-9.+-]", "", l) or "custom"

# ---- Alpine apk ------------------------------------------------------------

def parse_pkginfo_kv(text: str):
    """解析 .PKGINFO / abuild 的 key = value 格式 (支持缩进续行).

    与 deb control 类似但更宽松: 同名 key 后者覆盖前者 (apk 里 depends 可能
    出现多行同名, 但实际 abuild 会把它们合并到一行空格分隔).

    Parse .PKGINFO / abuild "key = value" format, including indented continuation lines.

    Similar to deb control but looser: a repeated key overwrites the previous value
    (abuild normally merges multi-value fields into one space-separated line).
    """
    kv = {}
    last = None
    for line in text.splitlines():
        m = re.match(r"^(\w[\w-]*)\s*=\s*(.*)$", line)
        if m:
            last = m.group(1)
            kv[last] = m.group(2).strip()
        elif line.startswith(" ") and last:
            kv[last] += "\n" + line.strip()
    return kv


def pkg_apk(path: str, opts) -> Tuple[Metadata, str, str]:
    """解析 Alpine apk (本质是 gzip 压缩的 tar, 首成员为 .PKGINFO).

    apk v2 的成员布局: .SIGN.* / .PKGINFO / 实际文件树 / 可选的 .pre-install 等.
    元文件会在最后从文件树里剔除, 避免被当成包内容安装到系统.

    依赖语法: 空格分隔, 每项可带 <,<=,=,>=,>,~ 约束; 以 so:/cmd: 开头的是
    虚拟能力 (对应 RPM 的 soname), 一律丢弃.

    已知局限: 不支持 apk v3 (ADB 格式); '~' 在 apk 里是"同主版本及以上的模糊匹配",
    这里按 '=' 处理 (偏严格, 可能导致升级时需手动确认).

    Parse an Alpine apk (a gzip-compressed tar whose first member is .PKGINFO).

    apk v2 layout: .SIGN.* / .PKGINFO / file tree / optional .pre-install etc.
    Metadata files are removed from the tree at the end so they are never installed.

    Dependency syntax: space-separated items with <,<=,=,>=,>,~ constraints; items
    starting with so:/cmd: are virtual capabilities (like rpm sonames) and dropped.

    Limitation: apk v3 (ADB format) is unsupported; apk's '~' means "same major
    version or newer" but is treated as '=' here (stricter, may require manual
    confirmation on upgrades).
    """
    work = tempfile.mkdtemp(prefix="alltap-apk-")
    fdir = os.path.join(work, "files")
    bsdtar_extract(path, fdir)

    # 读 .PKGINFO
    # read .PKGINFO
    kv = {}
    pinfo = os.path.join(fdir, ".PKGINFO")
    if os.path.exists(pinfo):
        kv = parse_pkginfo_kv(open(pinfo, encoding="utf8", errors="replace").read())

    meta = Metadata(source_fmt="apk")
    meta.name = sanitize_pkgname(kv.get("pkgname", os.path.basename(path).split(".apk")[0]))
    ep, ver, rel = split_apk_version(kv.get("pkgver", "1.0-r0"))
    meta.epoch, meta.version, meta.release = ep, sanitize_ver(ver), rel
    desc = kv.get("pkgdesc", "") or ""
    meta.desc = desc.splitlines()[0].strip() or "(无描述)"
    meta.long_desc = "\n".join(desc.splitlines()[1:]).strip()
    meta.arch = map_arch(kv.get("arch", ""), "apk")
    meta.url = kv.get("url", "")
    meta.license = sanitize_license(kv.get("license", "unknown"))

    tr = opts.translator
    for dn in (kv.get("depends", "") or "").split():
        if any(rx.match(dn) for rx in APK_TRASH_RE):
            tr.droplog.append(dn)
            continue
        m = re.match(r"^(.*?)([<>=~]+)(.*)$", dn)
        name, op, ver = dn, None, None
        if m:
            name, op, ver = m.group(1), m.group(2).replace("~", ""), m.group(3)
            op = "=" if op in ("=", "~") else (">=" if op == ">=" else ("<=" if op == "<=" else (">" if op == ">" else ("<" if op == "<" else None))))
        d = Dep(name, op, ver)
        nd = tr.translate(d, "apk")
        if nd:
            meta.depends.append(nd)

    for pn in (kv.get("provides", "") or "").split():
        if any(rx.match(pn) for rx in APK_TRASH_RE) or "=" in pn:
            continue
        meta.provides.append(pn.replace("!", ""))
    for rn in (kv.get("replaces", "") or "").split():
        meta.replaces.append(rn)

    # alpine 安装脚本 → pacman 语义一一对应 (最好移植的场景)
    # Alpine install scripts map one-to-one onto pacman semantics (the easiest format to port)
    if not opts.no_scripts:
        pairs = {".pre-install": None, ".post-install": None, ".pre-upgrade": None,
                 ".post-upgrade": None, ".pre-deinstall": None, ".post-deinstall": None}
        for fname in pairs:
            sp = os.path.join(fdir, fname)
            if os.path.exists(sp):
                pairs[fname] = read_script(sp)
        mapping = {".pre-install": "pre_install", ".post-install": "post_install",
                   ".pre-upgrade": "pre_upgrade", ".post-upgrade": "post_upgrade",
                   ".pre-deinstall": "pre_remove", ".post-deinstall": "post_remove"}
        for src, body in pairs.items():
            if body:
                meta.scripts[mapping[src]] = body

    # 从文件树剔除 meta 文件
    # strip metadata files from the file tree
    for junk in (".PKGINFO", ".PKGINFO.new", ".SIGN.RSA.alpine-devel@lists.alpinelinux.org-4a6a0840.rsa.pub",
                 ".trigger", ".apk-new", ".pre-install", ".post-install", ".pre-upgrade",
                 ".post-upgrade", ".pre-deinstall", ".post-deinstall",
                 ".autodeps"):
        p = os.path.join(fdir, junk)
        if os.path.exists(p):
            os.remove(p)
    for junkdir in (".SIGN",):
        p = os.path.join(fdir, junkdir)
        if os.path.isdir(p):
            shutil.rmtree(p)
    # 通配 .SIGN.*
    # wildcard .SIGN.*
    for name in list(os.listdir(fdir)):
        if name.startswith(".SIGN."):
            p = os.path.join(fdir, name)
            shutil.rmtree(p) if os.path.isdir(p) else os.remove(p)
    return meta, fdir, work


def split_apk_version(v: str):
    """拆 apk 的 "[epoch:]pkgver-r<pkgrel>" -> (epoch, version, release).

    无 -rN 后缀时 pkgrel 给 "0" — apk 世界里 0 是合法的初始 release.

    Split apk's "[epoch:]pkgver-r<pkgrel>" -> (epoch, version, release).

    Without -rN the release defaults to "0", which is a valid initial release in the
    apk world.
    """
    v = v.strip()
    epoch = ""
    m = re.match(r"^(\d+):(.*)$", v)
    if m:
        epoch, v = m.group(1), m.group(2)
    m = re.match(r"^(.*)-r(\d+)$", v)
    if m:
        return epoch, m.group(1), m.group(2)
    return epoch, v, "0"
# ---- Slackware ---------------------------------------------------------------

def pkg_slack(path: str, opts) -> Tuple[Metadata, str, str]:
    """解析 Slackware 包 (name-version-arch-build.txz 命名规范).

    Slackware 包没有独立元数据文件, 信息全靠文件名 + install/slack-desc:
      * 文件名四段: name-version-arch-build, 版本/架构/build 均从中提取;
      * install/slack-desc 是 "|手型图标|包名: 描述" 的固定格式, 第一行作短描述,
        后续非空行拼长描述;
      * install/doinst.sh 是安装后脚本, 对应 pacman 的 post_install/post_upgrade;
      * install/ 目录本身不是包内容, 必须剔除.
    不支持 .tar.lz/.tar.zst 等非标准后缀 (Slackware 官方只用 tgz/txz).

    Parse a Slackware package (name-version-arch-build.txz naming convention).

    Slackware packages have no standalone metadata file; information comes from the
    filename and install/slack-desc:
      * filename has four fields: name-version-arch-build;
      * install/slack-desc uses "|icon|pkgname: description"; the first text line is
        the short description, following non-empty lines form the long description;
      * install/doinst.sh is a post-install script -> post_install/post_upgrade;
      * the install/ directory itself is metadata and must be removed.
    Non-standard suffixes such as .tar.lz/.tar.zst are unsupported.
    """
    base = os.path.basename(path)
    m = re.match(r"^(.+)-([^-]+)-([^-]+)-(\d+)(?:\.txz|\.tgz|\.tar\.xz|\.tar\.gz)$", base, re.I)
    if not m:
        die(f"Slackware 包文件名不合规范: {base} (应为 name-version-arch-build.txz)")
    name, ver, arch, build = m.groups()

    work = tempfile.mkdtemp(prefix="alltap-slk-")
    fdir = os.path.join(work, "files")
    bsdtar_extract(path, fdir)

    meta = Metadata(source_fmt="slack")
    meta.name = sanitize_pkgname(name)
    meta.version = sanitize_ver(ver)
    meta.release = build
    meta.arch = map_arch(arch, "slack")

    # slack-desc
    sdesc = os.path.join(fdir, "install", "slack-desc")
    if os.path.exists(sdesc):
        brief, longd = "", []
        for line in open(sdesc, encoding="utf8", errors="replace").read().splitlines():
            if line.startswith("|") or not line.strip():
                continue
            if ":" in line:
                txt = line.split(":", 1)[1].strip()
                if not brief:
                    brief = txt
                elif txt:
                    longd.append(txt)
        meta.desc = brief or "(Slackware 包, 无描述)"
        meta.long_desc = "\n".join(longd)
    else:
        meta.desc = f"(Slackware 包 {name})"

    # install/ 目录剔除
    # drop the install/ directory
    idir = os.path.join(fdir, "install")
    if os.path.isdir(idir):
        # doinst.sh 仅记录说明
        # doinst.sh is only noted (its body is ported to post_install)
        doinst = os.path.join(idir, "doinst.sh")
        if os.path.exists(doinst) and not opts.no_scripts:
            body = read_script(doinst)
            if body:
                meta.scripts["post_install"] = body
                meta.scripts["post_upgrade"] = body
        shutil.rmtree(idir)
    return meta, fdir, work


# ---- AppImage ----------------------------------------------------------------

def pkg_appimage(path: str, opts) -> Tuple[Metadata, str, str]:
    """重打包 AppImage: 整个 .AppImage 放入 <prefix>/<name>/ , 并建 /usr/bin 链.

    AppImage 是"自挂载的 ELF + squashfs", 直接当普通 ELF 装到 /usr/bin 也能跑,
    但会丢掉内部 desktop/icon 的上下文; 这里选择保留原文件、用软链接暴露命令,
    卸载时只需删一个目录, 且不破坏 AppImage 自身的校验/更新机制.

    名称/版本推断: 去掉 .AppImage 后缀, 再尝试拆出结尾的 -v1.2.3 / -1.2.3;
    均可用 -n/-v 覆盖. 架构从 ELF header 的 e_ident[EI_CLASS] + e_machine 判定.
    局限: 不解包 squashfs, 因此拿不到 .desktop/图标与 AppImage 内部元数据.

    Repackage an AppImage: place the whole .AppImage under <prefix>/<name>/ and
    link it from /usr/bin.

    An AppImage is a self-mounting ELF + squashfs. Installing it as a plain ELF in
    /usr/bin would work but loses desktop/icon context; keeping the original file
    and exposing a symlink preserves AppImage's own verification/update behavior and
    makes uninstalling a single directory removal.

    Name/version inference: strip .AppImage, then try to split a trailing
    -v1.2.3 / -1.2.3; both can be overridden with -n/-v. Architecture is read from
    the ELF header. Limitation: squashfs is not unpacked, so .desktop/icons and
    internal AppImage metadata are unavailable.
    """
    base = os.path.basename(path)
    raw = base[:-len(".AppImage")] if base.lower().endswith(".appimage") else base
    mver = re.match(r"^(.*?)-v?([0-9][0-9A-Za-z.+-]*)$", raw)
    if mver:
        raw, raw_ver = mver.group(1), mver.group(2)
    else:
        raw, raw_ver = raw, "1.0"
    name = sanitize_pkgname(opts.name or raw)
    ver = opts.version or raw_ver

    work = tempfile.mkdtemp(prefix="alltap-appi-")
    fdir = os.path.join(work, "files")
    prefix = opts.prefix.format(pkgname=name) if "{pkgname}" in opts.prefix else (opts.prefix.rstrip("/") + "/" + name)
    appdir = os.path.join(fdir, prefix.lstrip("/"))
    os.makedirs(appdir, exist_ok=True)
    shutil.copy2(path, os.path.join(appdir, f"{name}.AppImage"))
    os.chmod(os.path.join(appdir, f"{name}.AppImage"), 0o755)
    bindir = os.path.join(fdir, "usr", "bin")
    os.makedirs(bindir, exist_ok=True)
    os.symlink(f"{prefix}/{name}.AppImage", os.path.join(bindir, name))

    # 从 ELF 判架构
    # e_ident[4]: 1=32 位, 2=64 位; e_machine 在偏移 18 (小端 uint16).
    # 只识别四种常见目标; 其余保持 x86_64 默认值 (可用 -a 覆盖).
    # detect architecture from the ELF header
    # e_ident[4]: 1=32-bit, 2=64-bit; e_machine lives at offset 18 (little-endian uint16).
    # only four common targets are recognized; everything else keeps the x86_64 default (override
    # with -a).
    arch = "x86_64"
    try:
        with open(path, "rb") as f:
            h = f.read(20)
            if h[:4] == b"\x7fELF":
                fm = h[4]
                bit = {1: 32, 2: 64}.get(fm, 64)
                mach = struct.unpack("<H", h[18:20])[0]
                if bit == 64 and mach == 0x3e:
                    arch = "x86_64"
                elif bit == 64 and mach == 0xb7:
                    arch = "aarch64"
                elif bit == 32 and mach == 0x03:
                    arch = "i686"
                elif bit == 64 and mach == 0xf3:
                    arch = "riscv64"
    except OSError:
        pass

    meta = Metadata(source_fmt="appimage")
    meta.name = name
    e, v, r = split_deb_version(ver)
    meta.epoch, meta.version, meta.release = e, sanitize_ver(v), sanitize_rel(r)
    meta.desc = opts.desc or f"AppImage 重打包: {raw}"
    meta.arch = opts.arch or arch
    meta.license = "unknown"
    return meta, fdir, work

# ---- 通用归档 ----------------------------------------------------------------
# ---- generic archive -----------------------------------------------------

def pkg_tarball(path: str, opts) -> Tuple[Metadata, str, str]:
    """处理普通归档 (.tar.gz/.xz/.zst/.tgz...), 两种布局策略:

    A. 含系统树 (usr/ etc/ lib/ bin/ ...) -> 直接作为包根, 可选剥掉一层顶层目录;
       适用于 "myapp-1.0/usr/bin/myapp" 这种被多了层目录的发布包.
    B. 不含系统树 -> 整体移到 <prefix>/<pkgname>/ (默认 /opt/<pkgname>),
       避免把散装文件塞到 /usr 或根目录.

    名称/版本推断优先级: -n/-v 命令行 > 单顶层目录名拆解 > 归档文件名.

    顶层目录本身是系统目录时 (如直接用 `tar -cf pkg.tar usr`) 不会被当成
    包装层剥掉, 否则 /usr/bin 会错误地变成 /bin.

    Handle a generic archive (.tar.gz/.xz/.zst/.tgz...), with two layout strategies:

    A. contains a system tree (usr/ etc/ lib/ bin/ ...) -> use it as the package
       root, optionally stripping one wrapper directory; suitable for release
       tarballs like "myapp-1.0/usr/bin/myapp".
    B. no system tree -> move everything under <prefix>/<pkgname> (default
       /opt/<pkgname>) instead of scattering files into /usr or /.

    Name/version priority: -n/-v > single top-level directory name > archive name.

    If the single top-level directory is itself a system directory (e.g. a tarball
    made with `tar -cf pkg.tar usr`), it is NOT treated as a wrapper; otherwise
    /usr/bin would incorrectly become /bin.
    """
    names = bsdtar_list(path)
    tops = sorted({n.split("/")[0] for n in names if "/" in n and n.split("/")[0] not in (".", "..")})
    single_top = tops[0] if len(tops) == 1 else None
    sys_dirs = {"usr", "etc", "lib", "lib32", "lib64", "bin", "sbin", "opt", "var"}
    # 只有"非系统目录"的顶层才可能是发布包的包装层; 系统目录必须原样保留.
    # only a top-level directory that is NOT a system directory can be a release wrapper; system
    # directories must be preserved.
    strip_top = single_top is not None and single_top not in sys_dirs
    prefix = (single_top + "/") if strip_top else ""

    def rel(n):
        """把成员路径里被推断出的"包装层"前缀剥掉.

        Strip the inferred "wrapper layer" prefix from a member path.
        """
        return n[len(prefix):] if prefix and n.startswith(prefix) else n

    # 系统树判定: 允许归档带一层顶层目录 (如 myapp-9/usr/...)
    # system-tree detection: allow one wrapper directory (e.g. myapp-9/usr/...)
    has_system = any(rel(n).split("/")[0] in sys_dirs for n in names if "/" in n)
    has_system = has_system or any(rel(n) in sys_dirs for n in names)

    work = tempfile.mkdtemp(prefix="alltap-tb-")
    fdir = os.path.join(work, "files")
    bsdtar_extract(path, fdir)

    meta = Metadata(source_fmt="tarball")
    guess_name, guess_ver = "pkg", "1.0"
    if opts.name:
        guess_name = opts.name
        guess_ver = opts.version or "1.0"
    elif single_top:
        m = re.match(r"^([A-Za-z0-9._+-]+?)[-_.]?v?(\d[\w.+]*)$", single_top)
        if m:
            guess_name, guess_ver = m.group(1), m.group(2)
        else:
            guess_name = single_top.lower()
    else:
        guess_name = os.path.basename(path).split(".")[0].lower()

    if strip_top and has_system:
        # 包装层 + 系统树: 剥掉包装层 (如 foo-1.0/usr/bin -> usr/bin)
        # wrapper directory + system tree: strip the wrapper (e.g. foo-1.0/usr/bin -> usr/bin)
        sub = os.path.join(fdir, single_top)
        if os.path.isdir(sub):
            for item in os.listdir(sub):
                shutil.move(os.path.join(sub, item), os.path.join(fdir, item))
            os.rmdir(sub)
    elif not has_system:
        # 无系统树 → 统一装到 <prefix>/<pkgname> (默认 /opt/<pkgname>)
        # no system tree -> install under <prefix>/<pkgname> (default /opt/<pkgname>)
        pname = sanitize_pkgname(guess_name)
        pfx = (opts.prefix.format(pkgname=pname) if "{pkgname}" in opts.prefix
               else (opts.prefix.rstrip("/") + "/" + pname))
        tgt = os.path.join(fdir, pfx.lstrip("/"))
        # 先搬到 fdir 之外的 stage, 再整体放入目标目录:
        # 否则自定义 prefix (如 /usr/local/<pkg>) 会使目标位于待搬目录内部,
        # shutil.move 报 "Cannot move a directory into itself".
        # move into a stage outside fdir first, then move everything into the target directory:
        # otherwise a custom prefix (e.g. /usr/local/<pkg>) puts the target inside a directory being
        # moved,
        # shutil.move reports "Cannot move a directory into itself".
        stage = tempfile.mkdtemp(prefix="alltap-stage-", dir=work)
        if single_top:
            sub = os.path.join(fdir, single_top)
            for item in os.listdir(sub):
                shutil.move(os.path.join(sub, item), os.path.join(stage, item))
            os.rmdir(sub)
        else:
            for item in os.listdir(fdir):
                shutil.move(os.path.join(fdir, item), os.path.join(stage, item))
        os.makedirs(tgt, exist_ok=True)
        for item in os.listdir(stage):
            shutil.move(os.path.join(stage, item), os.path.join(tgt, item))
        shutil.rmtree(stage, ignore_errors=True)

    meta.name = sanitize_pkgname(guess_name)
    e, v, r = split_deb_version(guess_ver)
    meta.epoch, meta.version, meta.release = e, sanitize_ver(v), sanitize_rel(r)
    meta.desc = opts.desc or f"通用归档重打包: {os.path.basename(path)}"
    meta.arch = opts.arch or "any"
    meta.license = "unknown"
    return meta, fdir, work

# ---- Arch 包重打包 ------------------------------------------------------------
# ---- Arch package repack --------------------------------------------------

def pkg_archpkg(path: str, opts) -> Tuple[Metadata, str, str]:
    """重打包 Arch 包: 保留文件树, 重新生成 .PKGINFO/.MTREE, 可改元数据.

    用途主要是"修正已有包的元数据" (改包名/依赖/描述后重打), 也可用于
    测试打包器自身. .INSTALL 以 __raw__ 形式原样保留; 其余打包元文件
    (.PKGINFO/.MTREE/.BUILDINFO/.CHANGELOG) 删除后由 build_pkg_file 重建.
    局限: 不保留 group/backup 等字段 (Metadata 未建模).

    Repackage an Arch package: keep the file tree, regenerate .PKGINFO/.MTREE,
    and optionally modify metadata.

    Mainly used to correct metadata (rename, change dependencies/description), and
    to test the packager itself. .INSTALL is preserved verbatim via __raw__; other
    packaging files (.PKGINFO/.MTREE/.BUILDINFO/.CHANGELOG) are removed and rebuilt.
    Limitation: fields not modeled by Metadata (backup, etc.) are not preserved.
    """
    work = tempfile.mkdtemp(prefix="alltap-pkg-")
    fdir = os.path.join(work, "files")
    bsdtar_extract(path, fdir)
    pinfo = os.path.join(fdir, ".PKGINFO")
    if not os.path.exists(pinfo):
        die("这不是有效的 Arch 包 (缺 .PKGINFO)")
    text = open(pinfo, encoding="utf8", errors="replace").read()
    kv = parse_pkginfo_kv(text)

    # .PKGINFO 是 "key = value" 多行格式, 同一 key 可重复 (depend/license...)
    # '.PKGINFO' is a multi-line "key = value" format; the same key may repeat (depend/license...)
    def get_lists(key):
        return re.findall(rf"^{re.escape(key)}\s*=\s*(.*)$", text, re.M)

    meta = Metadata(source_fmt="archpkg")
    meta.name = sanitize_pkgname(kv.get("pkgname", "pkg"))
    if opts.name:
        meta.name = sanitize_pkgname(opts.name)
    full = kv.get("pkgver", "1.0-1")
    if ":" in full:
        meta.epoch, full = full.split(":", 1)
    if "-" in full:
        meta.version, meta.release = full.rsplit("-", 1)
    else:
        meta.version, meta.release = full, "1"
    meta.desc = kv.get("pkgdesc", "(无描述)").splitlines()[0]
    meta.long_desc = kv.get("pkgdesc", "")
    meta.arch = map_arch(kv.get("arch", "x86_64"), "")
    meta.url = kv.get("url", "")
    meta.license = sanitize_license(kv.get("license", "unknown"))
    for d in get_lists("depend"):
        for (nm, op, ver) in [parse_pacman_dep(d)]:
            if nm:
                meta.depends.append(Dep(nm, op, ver))
    for o in get_lists("optdepend"):
        meta.optdepends.append(o)
    for p in get_lists("provides"):
        meta.provides.append(p)
    for c in get_lists("conflict"):
        meta.conflicts.append(c)
    for r in get_lists("replaces"):
        meta.replaces.append(r)
    for g in get_lists("group"):
        meta.groups.append(g)

    # .INSTALL 整体原样保留: 重写函数体会丢失原脚本的 shell 细节
    # keep .INSTALL verbatim: rewriting the functions would lose shell details of the original
    # scripts
    inst = os.path.join(fdir, ".INSTALL")
    if os.path.exists(inst) and not opts.no_scripts:
        meta.scripts["__raw__"] = open(inst, encoding="utf8", errors="replace").read()
    # remove 元文件 (重打)
    # remove metadata files (they are regenerated)
    for j in (".PKGINFO", ".MTREE", ".BUILDINFO", ".INSTALL", ".CHANGELOG", ".CHANGELOGS"):
        p = os.path.join(fdir, j)
        if os.path.exists(p):
            os.remove(p)
    return meta, fdir, work


def parse_pacman_dep(s: str):
    """拆分 pacman 依赖串 -> (name, op, ver); 无比较符时 op/ver 为 None.

    贪婪匹配 [?] 避免把包名里的 '-' 误当比较符 — 只看 <=>= 四个字符.

    Split a pacman dependency string -> (name, op, ver); op/ver are None when
    there is no comparison operator.

    Only the four comparison characters are treated as operators, so '-' inside a
    package name is never misparsed.
    """
    m = re.match(r"^([^<>=]+?)((<=|>=|=|<|>)(.*))?$", s.strip())
    if not m:
        return (s.strip(), None, None)
    return m.group(1), m.group(3), m.group(4)

# ---------------------------------------------------------------------------
# 打包: .PKGINFO + .MTREE + .INSTALL → bsdtar → .pkg.tar.zst
# packaging: .PKGINFO + .MTREE + .INSTALL -> bsdtar -> .pkg.tar.zst
# ---------------------------------------------------------------------------

def write_pkginfo(meta: Metadata, pkgroot: str, tree_size: int):
    """生成 .PKGINFO — pacman 读取的包元数据清单.

    几个容易踩的点:
      * pkgver 必须包含 "[epoch:]version-pkgrel" 整串 (不是只写 version);
      * 同一 key 可重复出现 (license/depend/optdepend/provides...),
        pacman 按行读取, 所以多值字段逐行追加;
      * pkgdesc 不能含换行 (多行会被解析器当成新字段), 统一压成单行;
      * size 单位为字节.

    Generate .PKGINFO — the package metadata read by pacman.

    Pitfalls:
      * pkgver must contain the whole "[epoch:]version-pkgrel" string;
      * the same key may repeat (license/depend/optdepend/provides...);
      * pkgdesc must not contain newlines (they would start a new field);
      * size is in bytes.
    """
    lines = [
        f"pkgname = {meta.name}",
        f"pkgbase = {meta.name}",
        f"pkgver = {meta.fullver}",
    ]
    if meta.desc:
        lines.append("pkgdesc = " + " ".join(meta.desc.split()))
    if meta.url:
        lines.append(f"url = {meta.url.replace(' ', '%20')}")
    lines.append(f"builddate = {int(time.time())}")
    lines.append(f"packager = alltap <alltap@localhost>")
    lines.append(f"size = {tree_size}")
    lines.append(f"arch = {meta.arch}")
    for lic in meta.license.split():
        lines.append(f"license = {lic}")
    for d in meta.depends:
        lines.append(f"depend = {d.to_pacman()}")
    for o in meta.optdepends:
        lines.append(f"optdepend = {o.replace(chr(10), ' ')}")
    for p in meta.provides:
        lines.append(f"provides = {p}")
    for c in meta.conflicts:
        lines.append(f"conflict = {c}")
    for r in meta.replaces:
        lines.append(f"replaces = {r}")
    for grp in meta.groups:
        lines.append(f"group = {grp}")
    out = os.path.join(pkgroot, ".PKGINFO")
    with open(out, "w", encoding="utf8") as f:
        f.write("\n".join(lines) + "\n")
    return out


def write_install(meta: Metadata, pkgroot: str):
    """生成 .INSTALL (pacman 安装脚本).

    两种来源:
      * __raw__: Arch 包重打包, 原文写回, 不做任何改写;
      * 移植脚本: 把各格式的维护脚本包装成 pacman 认识的六个钩子函数.
    返回写入路径; 没有任何脚本时返回 None (调用方据此决定是否把 .INSTALL 入包).

    Generate .INSTALL (pacman install script).

    Two sources: __raw__ (an Arch package repack, written back verbatim) or ported
    scripts wrapped into the six pacman hooks. Returns the path, or None when there
    are no scripts (the caller then omits .INSTALL from the package).
    """
    raw = meta.scripts.get("__raw__")   # 不清除, 支持修复循环中多次打包
                                        # do not clear it: the repair loop may repackage several times
    if raw:
        body = raw
    else:
        wanted = [k for k in ("pre_install", "post_install", "pre_upgrade",
                              "post_upgrade", "pre_remove", "post_remove") if k in meta.scripts]
        if not wanted:
            return None
        chunks = [f"# 本安装脚本由 alltap 自 {meta.source_fmt} 包维护脚本自动移植, 语义可能有差异, 请酌情检查"]
        for k in wanted:
            chunks.append(f"{k}() {{\n{meta.scripts[k]}\n}}\n")
        body = "\n".join(chunks)
    out = os.path.join(pkgroot, ".INSTALL")
    with open(out, "w", encoding="utf8") as f:
        f.write(body + "\n")
    return out


def tree_size_bytes(d: str) -> int:
    """递归统计文件树的总字节数 (仅普通文件, 不计目录).

    makepkg 用 `du -sk` 估算 (含目录项开销), 这里用 lstat 精确求和,
    两者会有小幅差异 — 但 .PKGINFO 的 size 只用于展示, 不影响安装.

    Recursively sum the byte size of a file tree (regular files only, no directories).

    makepkg estimates with `du -sk` (including directory overhead), so numbers may
    differ slightly; .PKGINFO size is informational and does not affect installation.
    """
    total = 0
    for root, _, files in os.walk(d):
        for fn in files:
            try:
                total += os.lstat(os.path.join(root, fn)).st_size
            except OSError:
                pass
    return total


def build_pkg_file(meta: Metadata, tree_dir: str, outdir: str, workdir: str) -> str:
    """把文件树 + Metadata 打成 makepkg 风格的 .pkg.tar.zst, 返回成品路径.

    步骤 (与 makepkg 的打包阶段对齐):
      1. 复制文件树到 pkgroot (使用 copytree(symlinks=True), 保留符号链接);
      2. 写 .PKGINFO / .INSTALL;
      3. 用 bsdtar 生成 .MTREE 校验清单 (不包含 .MTREE 自身);
      4. bsdtar 流式打包 -> zstd 压缩.

    条目顺序: .PKGINFO, .MTREE, .INSTALL, 其余按字母序 — pacman 不要求顺序,
    但固定顺序能让同样输入的包字节级可重现 (除 builddate 外).

    压缩级别用 -19 (makepkg 默认 --ultra -20, 两者体积接近; -19 明显更快).
    bsdtar 的 stderr 写入临时文件而非 PIPE, 避免特大包输出过多时管道缓冲写满死锁.

    Build a makepkg-style .pkg.tar.zst from a file tree + Metadata; returns the path.

    Steps (mirroring makepkg's packaging phase):
      1. copy the tree to pkgroot (copytree with symlinks=True);
      2. write .PKGINFO / .INSTALL;
      3. generate .MTREE with bsdtar (excluding .MTREE itself);
      4. stream bsdtar into zstd.

    Entry order: .PKGINFO, .MTREE, .INSTALL, then the rest alphabetically. pacman
    does not require an order, but a fixed order makes output reproducible except
    for builddate.

    zstd level is -19 (makepkg defaults to --ultra -20; sizes are close and -19 is
    much faster). bsdtar's stderr goes to a temp file instead of a pipe to avoid a
    full-pipe deadlock on very large packages.
    """
    if not which("bsdtar") or not which("zstd"):
        die("打包需要 bsdtar 与 zstd: sudo pacman -S libarchive zstd")
    os.makedirs(outdir, exist_ok=True)
    pkgroot = os.path.join(workdir, "pkgroot")
    if os.path.isdir(pkgroot):
        shutil.rmtree(pkgroot)
    shutil.copytree(tree_dir, pkgroot, symlinks=True)

    size = tree_size_bytes(pkgroot)
    write_pkginfo(meta, pkgroot, size)
    install_file = write_install(meta, pkgroot)

    entries = sorted(e for e in os.listdir(pkgroot)
                     if e not in (".PKGINFO", ".MTREE", ".INSTALL"))
    ordered = [".PKGINFO", ".MTREE"] + ([".INSTALL"] if install_file else []) + entries
    # mtree 列表不含 .MTREE 自身 (尚未生成)
    # the mtree list does not include .MTREE itself (not generated yet)
    mtree_list = [".PKGINFO"] + ([".INSTALL"] if install_file else []) + entries

    # 1) 生成 .MTREE (= makepkg 所做)
    # 1) generate .MTREE (same as makepkg)
    mtree_cmd = ["bsdtar", "-cf", "-", "--format=mtree",
                 "--options=!all,use-set,type,uid,gid,mode,time,size,md5,sha256,link",
                 "--uid", "0", "--gid", "0", "--uname", "root", "--gname", "root"] + mtree_list
    mtree = subprocess.run(mtree_cmd, cwd=pkgroot, check=True, capture_output=True).stdout
    with open(os.path.join(pkgroot, ".MTREE"), "wb") as f:
        f.write(mtree)

    # 2) 打包 zstd
    # 2) compress with zstd
    outpath = os.path.join(outdir, meta.pkgfilename)
    tar_cmd = ["bsdtar", "-cf", "-", "--format=gnutar",
               "--uid", "0", "--gid", "0", "--uname", "root", "--gname", "root"] + ordered
    err_path = os.path.join(workdir, "bsdtar.err")
    with open(err_path, "w+b") as errf:
        p1 = subprocess.Popen(tar_cmd, cwd=pkgroot, stdout=subprocess.PIPE, stderr=errf)
        p2 = subprocess.Popen(["zstd", "-q", "-T0", "-19", "-o", outpath, "-f"],
                              stdin=p1.stdout, stdout=subprocess.DEVNULL,
                              stderr=subprocess.PIPE)
        p1.stdout.close()
        _, zerr = p2.communicate()
        p1.wait()
        errf.seek(0)
        terr = errf.read().decode("utf8", "replace")
    try:
        os.remove(err_path)
    except OSError:
        pass
    if p2.returncode != 0:
        raise RuntimeError("zstd 压缩失败: " + zerr.decode("utf8", "replace"))
    if p1.returncode != 0:
        raise RuntimeError("bsdtar 打包失败: " + terr)
    return outpath

# ---------------------------------------------------------------------------
# PKGBUILD 生成 (-p 模式)
# PKGBUILD generation (-p mode)
# ---------------------------------------------------------------------------

def pkgbash_quote(s):
    """单引号转义, 用于把任意字符串安全嵌入 PKGBUILD 的 Bash 数组.

    ' -> '\\'' 是 POSIX shell 的标准写法 (结束单引号 + 转义单引号 + 重开).

    Single-quote escaping so arbitrary strings can be embedded safely in a
    PKGBUILD Bash array.

    ' -> '\'' is the POSIX shell idiom (close quote, escaped quote, reopen).
    """
    return "'" + s.replace("'", "'\\''") + "'"


def render_pkgbuild(meta: Metadata, src_file: str, src_format: str, outdir: str,
                    opts=None) -> str:
    """生成 PKGBUILD (debtap 兼容的 -p 模式).

    思路: 把原包当成本地 source (noextract 阻止 makepkg 自动解压),
    在 package() 里按格式选择对应的解包命令, 把内容直接展到 $pkgdir.

    epoch 按 PKGBUILD 规范写成独立变量 (pkgver 中出现 ':' 会被 makepkg 拒绝);
    license 按空格拆成数组; 统一加 options=(!strip !debug), 防止预编译二进制被
    makepkg 的 strip/debug 流程破坏; AppImage 安装路径跟随 --prefix.

    Generate a PKGBUILD (debtap-compatible -p mode).

    The original package is a local source (noextract prevents makepkg from
    extracting it); package() selects the right unpack command per format and
    expands the content into $pkgdir.

    epoch is written as a separate variable (makepkg rejects ':' in pkgver);
    license is split on spaces into the array; options=(!strip !debug) prevents
    makepkg from stripping or generating debug info for prebuilt binaries; the
    AppImage install path follows --prefix.
    """
    deps = [pkgbash_quote(d.to_pacman()) for d in meta.depends]
    optdeps = [pkgbash_quote(o) for o in meta.optdepends]
    provs = [pkgbash_quote(p) for p in meta.provides]
    conss = [pkgbash_quote(c) for c in meta.conflicts]
    repls = [pkgbash_quote(r) for r in meta.replaces]

    lines = []
    lines.append(f"# 由 alltap {VERSION} 从 {src_format} 包 {src_file} 生成")
    lines.append(f"# 原包信息: {meta.desc}")
    lines.append("")
    lines.append(f"pkgname={pkgbash_quote(meta.name)}")
    if meta.epoch:
        lines.append(f"epoch={pkgbash_quote(meta.epoch)}")
    lines.append(f"pkgver={pkgbash_quote(meta.version)}")
    lines.append(f"pkgrel={pkgbash_quote(meta.release)}")
    lines.append(f"pkgdesc={pkgbash_quote(meta.desc[:250])}")
    lines.append(f"arch=({pkgbash_quote(meta.arch)})")
    lines.append(f"url={pkgbash_quote(meta.url or 'https://example.invalid')}")
    lines.append("license=(" + " ".join(pkgbash_quote(x) for x in meta.license.split()) + ")")
    lines.append("options=('!strip' '!debug')")
    lines.append("depends=(" + " ".join(deps) + ")")
    if optdeps:
        lines.append("optdepends=(" + " ".join(optdeps) + ")")
    if provs:
        lines.append("provides=(" + " ".join(provs) + ")")
    if conss:
        lines.append("conflicts=(" + " ".join(conss) + ")")
    if repls:
        lines.append("replaces=(" + " ".join(repls) + ")")
    lines.append(f"source=({pkgbash_quote(src_file)})")
    lines.append(f"noextract=({pkgbash_quote(src_file)})")
    lines.append("md5sums=('SKIP')")
    lines.append("")
    lines.append("package() {")

    rel_src = src_file
    if src_format == "deb":
        lines.append("  cd \"$srcdir\"")
        lines.append(f"  ar x \"$srcdir/{rel_src}\"")
        lines.append("  tar -xf data.tar.* -C \"$pkgdir\"")
    elif src_format == "rpm":
        lines.append(f"  (cd \"$pkgdir\"; rpm2cpio \"$srcdir/{rel_src}\" | cpio -idmuv --no-absolute-filenames)")
        lines.append("  # 需要: rpm2cpio (AUR: rpmextract) 与 cpio")
    elif src_format == "apk":
        excl = "--exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.pre-*' --exclude='.post-*' --exclude='.trigger'"
        lines.append(f"  bsdtar -xf \"$srcdir/{rel_src}\" -C \"$pkgdir\" {excl}")
    elif src_format == "slack":
        lines.append(f"  bsdtar -xf \"$srcdir/{rel_src}\" -C \"$pkgdir\" --exclude='install'")
    elif src_format == "appimage":
        if opts is not None:
            pfx = (opts.prefix.format(pkgname=meta.name) if "{pkgname}" in opts.prefix
                   else (opts.prefix.rstrip("/") + "/" + meta.name))
        else:
            pfx = f"/opt/{meta.name}"
        lines.append(f"  install -Dm755 \"$srcdir/{rel_src}\" \"$pkgdir{pfx}/{meta.name}.AppImage\"")
        lines.append("  install -d \"$pkgdir/usr/bin\"")
        lines.append(f"  ln -s {pfx}/{meta.name}.AppImage \"$pkgdir/usr/bin/{meta.name}\"")
    elif src_format == "tarball":
        lines.append(f"  bsdtar -xf \"$srcdir/{rel_src}\" -C \"$pkgdir\"")
    else:
        lines.append(f"  bsdtar -xf \"$srcdir/{rel_src}\" -C \"$pkgdir\" --exclude='.PKGINFO' --exclude='.MTREE'")
    lines.append("}")
    if meta.scripts and "__raw__" not in meta.scripts:
        lines.append("\n# 安装脚本移植见注释; makepkg 用户请手动合并 install= 脚本")
    out = os.path.join(outdir, "PKGBUILD")
    with open(out, "w", encoding="utf8") as f:
        f.write("\n".join(lines) + "\n")
    return out

# ---------------------------------------------------------------------------
# 安装闭环: pacman -U 失败 → 诊断 → 自动修复 → 重试
# install loop: pacman -U fails -> diagnose -> auto-repair -> retry
# ---------------------------------------------------------------------------

class PacmanRunner:
    """统一封装 pacman 调用与提权策略.

    提权链 (prefix 只在首次用到时解析并缓存):
      1. 测试隔离根 ($ALLTAP_PACMAN_ROOT) / $ALLTAP_NO_SUDO / 已是 root -> 直跑;
      2. sudo -n true 探测成功 -> sudo -n (免密; 不会弹密码提示);
      3. 有 pkexec -> pkexec (图形环境弹授权框);
      4. 都没有 -> die.

    为什么查询走 query() 而不是 run(): 无 root 时 sudo/pkexec 自身的报错
    (如 "a password is required") 会被当成 pacman 输出, 导致误判. 只读查询
    (pacman -T / -Si) 不需要提权, 因此单独走无权路径.

    Wrap pacman invocation and privilege escalation.

    Escalation chain (prefix resolved on first use and cached):
      1. isolated test root ($ALLTAP_PACMAN_ROOT) / $ALLTAP_NO_SUDO / already root -> direct;
      2. sudo -n true succeeds -> sudo -n (no password prompt);
      3. pkexec available -> pkexec (graphical authorization);
      4. otherwise -> die.

    Read-only queries use query() instead of run(): without root, sudo/pkexec error
    messages would be mistaken for pacman output. pacman -T / -Si need no privilege.
    """

    def __init__(self, opts):
        self.opts = opts
        self.bin = os.environ.get("ALLTAP_PACMAN", "pacman")
        self.root = os.environ.get("ALLTAP_PACMAN_ROOT", "")   # 测试用: 隔离安装根
        # for testing: isolated install root
        self.no_sudo = os.environ.get("ALLTAP_NO_SUDO") == "1"
        self._prefix = None

    def prefix(self):
        """解析并缓存提权前缀 (见类 docstring 的四级策略).

        Resolve and cache the privilege prefix (see the class docstring's four-level chain).
        """
        if self._prefix is not None:
            return self._prefix
        if self.root or self.no_sudo or os.geteuid() == 0:
            self._prefix = ["env", "LC_ALL=C", self.bin]
        elif which("sudo") and subprocess.run(["sudo", "-n", "true"],
                                              capture_output=True).returncode == 0:
            self._prefix = ["sudo", "-n", "env", "LC_ALL=C", self.bin]
        elif which("pkexec"):
            self._prefix = ["pkexec", "env", "LC_ALL=C", self.bin]
        else:
            die("安装需要 root: 请以 root 运行 alltap, 或配置免密 sudo(-n) / 安装 pkexec")
        return self._prefix

    def base(self):
        """pacman 全局参数: 测试用 --root/--dbpath + $ALLTAP_PACMAN_EXTRA.

        Global pacman arguments: test-only --root/--dbpath + $ALLTAP_PACMAN_EXTRA.
        """
        args = []
        if self.root:
            args += ["--root", self.root,
                     "--dbpath", os.path.join(self.root, "var", "lib", "pacman")]
        extra = os.environ.get("ALLTAP_PACMAN_EXTRA", "").split()
        return args + extra

    def _exec(self, cmd, args, quiet=False):
        """执行并合并 stdout/stderr; 超时返回 124 (与 timeout(1) 一致).

        quiet=True 时不回显错误输出 — 用于 repo_has() 这类"失败即预期"的探测,
        避免刷一堆 "package not found" 干扰用户.

        Execute and merge stdout/stderr; timeout returns 124 (same as timeout(1)).

        quiet=True suppresses error output — used by repo_has() where failure is
        expected, avoiding a flood of "package not found" messages.
        """
        log.verb("$ " + " ".join(cmd + args))
        env = dict(os.environ)
        env["LC_ALL"] = "C"
        env["LANG"] = "C"
        try:
            p = subprocess.run(cmd + args, capture_output=True, text=True, env=env, timeout=1800)
        except subprocess.TimeoutExpired:
            return 124, "pacman 执行超时"
        out = (p.stdout or "") + (p.stderr or "")
        if p.returncode != 0 and not quiet and out.strip():
            log.info(out.rstrip())
        return p.returncode, out

    def run(self, args, quiet=False):
        """带提权前缀执行 pacman (写操作: -U/-S).

        Run pacman with the privilege prefix (write operations: -U/-S).
        """
        return self._exec(self.prefix() + self.base(), args, quiet)

    def query(self, args, quiet=False):
        """非特权查询 (-T / -Si 等): 只读数据库, 不走 sudo/pkexec 提权链
        避免无 root 时把提权器报错误判为 pacman 输出

        Unprivileged query (-T / -Si etc.): read-only database access, no sudo/pkexec,
        so escalator errors cannot be mistaken for pacman output.
        """
        return self._exec(["env", "LC_ALL=C", self.bin] + self.base(), args, quiet)

    def install(self, pkgpaths, overwrite=None):
        """pacman -U; pkgpaths 可为单路径或多路径 (多包单事务)

        pacman -U; pkgpaths may be one path or a list (single transaction for multiple packages).
        """
        args = ["-U", "--noconfirm"]
        for f in overwrite or []:
            args += ["--overwrite", f]
        args += list(pkgpaths) if isinstance(pkgpaths, (list, tuple)) else [pkgpaths]
        return self.run(args)

    def sync_asdeps(self, names):
        """--asdeps 安装依赖: 标记为"被依赖"而非用户主动安装, 避免计入显式包列表.

        Install dependencies with --asdeps: marked as "required by another package"
        rather than explicitly installed, so they do not enter the explicit package list.
        """
        return self.run(["-S", "--asdeps", "--noconfirm"] + names)

    def repo_has(self, name):
        """官方仓库是否有此包 (pacman -Si 返回 0 即存在).

        Whether the official repositories contain this package (pacman -Si exit 0).
        """
        rc, _ = self.query(["-Si", name], quiet=True)
        return rc == 0


PACMAN_CONFLICT = re.compile(r"^(\S+): (\S+) exists in filesystem", re.M)
PACMAN_REQUIRE_1 = re.compile(r"^(?::: )?([^:\n]+): requires (\S+)", re.M)
PACMAN_REQUIRE_2 = re.compile(r"unable to satisfy dependency '([^']+)'", re.M)
PACMAN_REQUIRE_3 = re.compile(r"could not find package (?:'([^']+)'|(\S+))", re.M)
PACMAN_BREAKS = re.compile(
    r"installing (\S+) \(([^)]*)\) breaks dependency '([^']+)' required by (\S+)")


def parse_pacman_failure(out: str):
    """把 pacman 失败输出分类成可修复的错误.

    返回 dict:
      kind   conflict(文件冲突) / missing(缺依赖) / breaks(依赖被破坏) / other
      deps   缺失的依赖串 (可能带版本约束)
      files  冲突的文件路径 (绝对路径)
      notes  仅供人读的补充说明

    为什么不靠退出码: pacman 各种失败都返回非 0, 只能靠文本模式区分;
    LC_ALL=C 由 PacmanRunner 强制, 因此这些英文模板是稳定的.

    Classify pacman failure output into repairable errors.

    Returns dict:
      kind   conflict / missing / breaks / other
      deps   missing dependency strings (may include version constraints)
      files  conflicting absolute file paths
      notes  human-readable extra information

    Exit codes cannot distinguish failures, so text patterns are used; LC_ALL=C is
    forced by PacmanRunner, making these English templates stable.
    """
    result = {"kind": "other", "deps": [], "files": [], "notes": []}

    files = [m.group(2) for m in PACMAN_CONFLICT.finditer(out)]
    if files:
        result["kind"] = "conflict"
        result["files"] = list(dict.fromkeys(files))

    deps = []
    for m in PACMAN_REQUIRE_1.finditer(out):
        deps.append(m.group(2))
    for m in PACMAN_REQUIRE_2.finditer(out):
        deps.append(m.group(1))
    for m in PACMAN_REQUIRE_3.finditer(out):
        deps.append(m.group(1) or m.group(2))
    # 过滤误捕获的句子片段
    # filter out sentence fragments captured by mistake
    deps = [d for d in dict.fromkeys(deps) if d and " " not in d and len(d) < 128]
    if deps:
        result["kind"] = "missing"
        result["deps"] = deps

    breaks = [m.groups() for m in PACMAN_BREAKS.finditer(out)]
    if breaks:
        result["notes"] = [f"安装 {a} ({b}) 破坏依赖 {d} (被 {o} 依赖)" for a, b, d, o in breaks]
        if not deps and not files:
            result["kind"] = "breaks"
    return result


def dep_base_name(d: str) -> str:
    """去掉版本约束, 只留包名: "glibc>=2.38" -> "glibc".

    Strip the version constraint, leaving only the package name:
    "glibc>=2.38" -> "glibc".
    """
    return re.split(r"[<>=]", d.strip(), 1)[0].strip()


def ask_confirm(opts, question, default=True):
    """交互确认; -y 自动同意; 非交互环境拒绝需要确认的动作.

    设计取向: 非 tty (定时任务/CI/管道) 一律返回 False — 宁可停下来让用户
    手动处理, 也不在无人监督时擅自改系统. -y 是唯一跳过确认的开关.

    Interactive confirmation; -y auto-approves; non-interactive environments reject.

    Design: a non-TTY (cron/CI/pipe) always returns False — better to stop and let
    the user handle it than to modify the system unattended. -y is the only bypass.
    """
    if opts.yes:
        return True
    if not sys.stdin.isatty():
        return False
    try:
        ans = input(question + (" [Y/n] " if default else " [y/N] "))
    except EOFError:
        return False
    ans = ans.strip().lower()
    if not ans:
        return default
    return ans in ("y", "yes", "是")


def find_dep(meta, base):
    """在 meta.depends 中按包名 (不含版本) 查 Dep 对象, 找不到返回 None.

    Find a Dep object by package name (ignoring version) in meta.depends;
    returns None when absent.
    """
    for d in meta.depends:
        if d.name == base:
            return d
    return None


class PKGSpec:
    """单个待装包的完整上下文: 多包事务与修复循环中的重打包都基于它.

    tree_dir 与 work 保留到事务结束: 修复循环可能多轮 rebuild(), 需要原始的
    文件树与同一个临时目录; 清理责任在 install_transaction 的调用方 (main).

    Complete context of one package to install; both the multi-package transaction
    and the repair loop's repackaging are based on it.

    tree_dir and work live until the transaction ends because the repair loop may
    call rebuild() several times; cleanup belongs to the caller of
    install_transaction (main).
    """

    def __init__(self, meta, tree_dir, outdir, work, pkgpath, fmt, srcfile):
        self.meta = meta
        self.tree_dir = tree_dir    # 包根文件树 (重打包源)
                                    # package root file tree (source for repackaging)
        self.outdir = outdir
        self.work = work            # 临时目录, 事务结束后统一清理
                                    # temporary directory, cleaned up after the transaction
        self.pkgpath = pkgpath
        self.fmt = fmt
        self.srcfile = srcfile

    def rebuild(self):
        """按当前 meta 重新打包 (依赖被移除/改名/放宽后调用)

        Repackage according to the current meta (after a dependency was removed,
        renamed or relaxed).
        """
        self.pkgpath = build_pkg_file(self.meta, self.tree_dir, self.outdir, self.work)
        return self.pkgpath


def specs_with_dep(specs, base):
    """返回 depends 中含该依赖名 (不含版本约束) 的全部 spec.

    Return every spec whose depends contains this dependency name (ignoring version).
    """
    return [s for s in specs if any(d.name == base for d in s.meta.depends)]


def batch_provided_names(specs):
    """本批包能提供的名字集合: 包名 + provides 基名 (用于判定"同批互相满足").

    Names provided by this batch: package names + provides base names
    (used to decide whether the batch satisfies itself).
    """
    names = set()
    for s in specs:
        names.add(s.meta.name)
        for pv in s.meta.provides:
            names.add(dep_base_name(pv))
    return names


# ---------------------------------------------------------------------------
# AUR 依赖兜底: 查询 AUR RPC, 由用户决定是否用 yay/paru 补装
# AUR fallback: query the AUR RPC; the user decides whether yay/paru should install it
# ---------------------------------------------------------------------------

AUR_RPC_TPL = "https://aur.archlinux.org/rpc/v5/info?arg[]={name}"


def aur_lookup(name: str):
    """查询 AUR RPC v5; 返回 ('found'|'absent'|'error', info dict or None).

    测试通道: ALLTAP_AUR_RPC 覆盖 URL 模板 (模板以 file: 开头时直接读本地
    文件, 便于离线 mock). 只精确匹配 Name, 不做模糊/拼音搜索.

    包名按 URL 规则百分百编码 ('+' -> %2B); file: 模板直接读本地文件, 便于离线 mock.

    Query AUR RPC v5; returns ('found'|'absent'|'error', info dict or None).

    Test channel: ALLTAP_AUR_RPC overrides the URL template; a template starting
    with file: reads a local file for offline mocks. Only an exact Name match is
    accepted (no fuzzy/pinyin search).

    Package names are fully URL-encoded ('+' -> %2B); file: templates read the local
    file directly for offline mocks.
    """
    tpl = os.environ.get("ALLTAP_AUR_RPC", AUR_RPC_TPL)
    if tpl.startswith("file:"):
        url = tpl.replace("{name}", name.replace("/", "_"))
    else:
        url = tpl.replace("{name}", quote(name, safe=""))
    try:
        if url.startswith("file:"):
            fpath = url[7:] if url.startswith("file://") else url[5:]
            with open(fpath, encoding="utf8") as f:
                body = f.read()
        else:
            if not which("curl"):
                log.warn("未找到 curl, 无法查询 AUR")
                return "error", None
            proc = subprocess.run(["curl", "-fsSL", "-m", "15", url],
                                  capture_output=True, text=True, timeout=25)
            if proc.returncode != 0:
                return "error", None
            body = proc.stdout
        data = json.loads(body)
        for r in data.get("results", []):
            if r.get("Name") == name:
                return "found", r
        return "absent", None
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        log.verb(f"AUR 查询失败 ({name}): {e}")
        return "error", None


def aur_helper_cmd():
    """AUR 助手命令; 测试通道 ALLTAP_AUR_HELPER 直接指定, 否则找 paru/yay

    AUR helper command; the test channel ALLTAP_AUR_HELPER overrides it,
    otherwise look for paru/yay.
    """
    env = os.environ.get("ALLTAP_AUR_HELPER")
    if env:
        return shlex.split(env)
    for b in ("paru", "yay"):
        if which(b):
            return [b]
    return None


def aur_install(names, opts):
    """用 AUR 助手补装 (不提权, AUR helper 自行处理); 返回 True/False

    Install with an AUR helper (no privilege escalation here; the helper handles it);
    returns True/False.
    """
    cmdbin = aur_helper_cmd()
    if not cmdbin:
        log.warn("未找到 yay/paru, 无法补装 AUR 依赖")
        return False
    cmd = cmdbin + ["-S", "--asdeps", "--noconfirm"] + list(names)
    log.info("$ " + " ".join(cmd))
    try:
        proc = subprocess.run(cmd, timeout=3600)
        return proc.returncode == 0
    except (OSError, subprocess.SubprocessError) as e:
        log.warn(f"AUR 助手执行失败: {e}")
        return False


def aur_summary(info):
    """把 AUR RPC 的一条 info 压成一行人类可读摘要 (版本/维护者/状态/票数).

    Compress one AUR RPC info record into a human-readable line
    (version / maintainer / status / votes).
    """
    bits = [f"版本 {info.get('Version', '?')}"]
    maint = info.get("Maintainer")
    bits.append(f"维护者 {maint}" if maint else "孤儿包 (无维护者)")
    if info.get("OutOfDate"):
        bits.append("已过期 (upstream)")
    votes = info.get("NumVotes", 0)
    if votes:
        bits.append(f"{votes} 票")
    return ", ".join(bits)


def try_aur_packages(bases, opts):
    """对仓库缺失的依赖查询 AUR; 返回 (可装列表 [(name, info)], 未查询到/失败列表).

    未启用 --aur 时不做任何网络请求, 直接把全部 bases 归入 skip (保持原有流程).

    Query AUR for dependencies missing from the repositories; returns
    (installable [(name, info)], not-found/failed list).

    Without --aur no network request is made and every base goes to skip, keeping
    the original flow.
    """
    installable, skip = [], []
    if not opts.aur:
        return installable, bases
    for b in bases:
        st, info = aur_lookup(b)
        if st == "found":
            installable.append((b, info))
        elif st == "absent":
            log.verb(f"AUR 中不存在 {b}")
            skip.append(b)
        else:
            log.warn(f"无法访问 AUR 查询 {b} (网络不可达?)")
            skip.append(b)
    return installable, skip


# ---------------------------------------------------------------------------
# 未知依赖处理: 交互改名/移除 (多包版, 定位依赖归属的包并重打包受影响者)
# unknown dependency handling: interactive rename/remove (multi-package version; locate the owning
# package and repackage it)
# ---------------------------------------------------------------------------

def handle_unknown_deps(specs, names, opts):
    """仓库/AUR 均无的依赖: 交互选择移除/改名.

    返回 ('rebuild'|'abort', 受影响的 spec 列表).
    -y 模式直接移除 (无人监督的默认策略), 非 tty 环境则中止而非擅动.

    Dependencies found in neither the repositories nor the AUR: interactive
    remove/rename.

    Returns ('rebuild'|'abort', affected specs). -y removes them directly (the
    unattended default); a non-TTY environment aborts rather than acting blindly.
    """
    log.warn(f"仓库中找不到依赖: {', '.join(names)}")
    for n in names:
        owners = ", ".join(s.meta.name for s in specs_with_dep(specs, n)) or "?"
        log.info(f"    {n} <- 被包 [{owners}] 引用")
    if opts.yes:
        affected = []
        for s in specs:
            hit = [d for d in s.meta.depends if d.name in names]
            if hit:
                s.meta.depends = [d for d in s.meta.depends if d.name not in names]
                affected.append(s)
        log.warn("(-y 自动模式) 已移除上述依赖, 重新打包: "
                 + ", ".join(s.meta.name for s in affected))
        return "rebuild", affected
    if not sys.stdin.isatty():
        log.warn("非交互环境无法询问; 安装中止 (可加 -y 自动移除, 或用 -k 保留原名后手动处理)")
        return "abort", []
    print("  可选择:")
    print("    [1] 从依赖中移除它们 (可能导致运行时缺库)")
    print("    [2] 改名映射到其它仓库包 / AUR 包后重试")
    print("    [3] 放弃安装 (包已生成, 可稍后手动处理)")
    try:
        choice = input("  选择 [1]: ").strip() or "1"
    except EOFError:
        return "abort", []
    affected = []
    for s in specs:
        if any(d.name in names for d in s.meta.depends):
            affected.append(s)
    if choice == "1":
        for s in affected:
            s.meta.depends = [d for d in s.meta.depends if d.name not in names]
        return "rebuild", affected
    if choice == "2":
        for n in names:
            try:
                new = input(f"    依赖 {n} 改为 (留空=移除): ").strip()
            except EOFError:
                new = ""
            for s in affected:
                d = find_dep(s.meta, n)
                if d is None:
                    continue
                if new:
                    d.name = sanitize_pkgname(new)
                else:
                    s.meta.depends.remove(d)
        return "rebuild", affected
    return "abort", []


# ---------------------------------------------------------------------------
# 安装事务: 一次 pacman -U 装全部包, 失败诊断修复后整批重试
# install transaction: one pacman -U for all packages, diagnose failures, repair, then retry the
# batch
# ---------------------------------------------------------------------------

def install_transaction(specs, opts):
    """多包安装自愈闭环: 返回 True 表示整批安装成功.

    状态机 (每轮都是一次完整的 pacman -U，失败后分类修复再重试):
      文件冲突 -> 询问后追加 --overwrite 精确路径
      缺依赖   -> ① 同批包可提供但版本不符 -> 放宽版本后重打包
                 ② 官方仓库有 -> pacman -S --asdeps 补装
                 ③ 仓库无 -> AUR 查询 (--aur) -> yay/paru 补装
                 ④ 都不行 -> 交互移除/改名后重打包
      其它     -> 直接失败 (成品包保留)

    防死循环三道锁: relaxed_deps (已放宽过的依赖不再放宽)、
    installed_deps (已补装的不再重复补)、overwrite_files (同一文件不重复询问).
    上限 max_tries (默认 5).

    Multi-package self-healing install loop; True means the whole batch installed.

    State machine (each round is a full pacman -U, then classify and repair):
      file conflict -> ask, then add exact --overwrite paths
      missing deps  -> (1) provided by the batch but version mismatch -> relax and repackage
                       (2) in the official repo -> pacman -S --asdeps
                       (3) not in repo -> AUR lookup (--aur) -> yay/paru
                       (4) otherwise -> interactive remove/rename and repackage
      other         -> fail (built packages are kept)

    Three anti-loop guards: relaxed_deps (never relax twice), installed_deps (never
    install twice), overwrite_files (never ask twice). Limit: max_tries (default 5).
    """
    if len(specs) == 1:
        log.info(f"\n=== 安装: {specs[0].meta.name} ===")
    else:
        log.info(f"\n=== 安装事务: {len(specs)} 个包 ===")
        for s in specs:
            log.info(f"    {s.meta.name} {s.meta.fullver}  <- {os.path.basename(s.srcfile)}")
        # 依赖由同批包互相满足的情况, pacman 同一事务会自动解决; 此处仅提示
        # dependencies satisfied within the same batch are resolved by pacman in one transaction;
        # only a hint is printed here
        batch_names = batch_provided_names(specs)
        for s in specs:
            cross = sorted({d.name for d in s.meta.depends if d.name in batch_names})
            if cross:
                log.info(f"    依赖 {', '.join(cross)} 由同批包提供 (同一事务自动满足)")

    runner = PacmanRunner(opts)
    installed_deps = set()      # 已补装的仓库/AUR 依赖名
                                # repository/AUR dependencies already installed
    relaxed_deps = set()        # 已放宽过版本的依赖名 (防死循环)
                                # dependencies whose version was already relaxed (prevents infinite loops)
    max_tries = max(1, opts.max_tries)
    overwrite_files = []         # 已确认要 --overwrite 的精确路径
                                 # exact paths already confirmed for --overwrite

    for attempt in range(1, max_tries + 1):
        pkgnames = " ".join(os.path.basename(s.pkgpath) for s in specs)
        log.info(f"\n[安装 {attempt}/{max_tries}] pacman -U {pkgnames}")
        rc, out = runner.install([s.pkgpath for s in specs], overwrite=overwrite_files)
        if rc == 0:
            log.info("✓ 安装成功")
            return True

        diag = parse_pacman_failure(out)

        # ---------- 文件冲突 ----------
        # pacman 的 "exists in filesystem" 不会自动覆盖; 用精确路径 --overwrite
        # 只放行本次确认的文件, 不用通配符, 避免误伤其它包的同名文件.
        # ---------- file conflicts ----------
        # pacman's "exists in filesystem" is not overwritten automatically; use exact --overwrite
        # paths
        # only allow the files confirmed this round; no wildcards, to avoid clobbering same-named
        # files of other packages.
        if diag["kind"] == "conflict" and diag["files"]:
            files = [f for f in diag["files"] if f not in overwrite_files]
            if not files:
                log.warn("文件冲突重复出现, 放弃安装")
                return False
            if opts.no_overwrite:
                log.warn("已禁用文件覆盖 (--no-overwrite), 放弃安装")
                return False
            log.info(f"检测到文件冲突 {len(files)} 个:")
            for f in files[:20]:
                log.info(f"    {f}")
            if len(files) > 20:
                log.info(f"    ... 共 {len(files)} 个")
            if not ask_confirm(opts, f"用 --overwrite 精确覆盖以上 {len(files)} 个文件?", default=False):
                return False
            overwrite_files += files
            log.info("    已记录冲突文件, 下一轮以 --overwrite 精确覆盖重试")
            continue

        # ---------- 缺依赖 ----------
        # 先把带版本约束的依赖串拆成基名, 再分为三类:
        #   batch_hit  本批包就能提供 (理论上应自动满足, 报错说明版本约束不符)
        #   repo_yes   官方仓库有 -> 可补装
        #   repo_no    仓库没有 -> 只能 AUR 或人工处理
        # ---------- missing dependencies ----------
        # split versioned dependency strings into base names, then classify into three groups:
        # batch_hit provided by a package in this batch (should be satisfied automatically; an error
        # means a version mismatch)
        # repo_yes present in the official repositories -> can be installed automatically
        # repo_no not in the repositories -> only AUR or manual handling
        if diag["kind"] == "missing" and diag["deps"]:
            for n in diag["notes"]:
                log.warn(n)
            bases = []
            for d in diag["deps"]:
                b = dep_base_name(d)
                if b and b not in bases:
                    bases.append(b)
            batch_names = batch_provided_names(specs)
            repo_yes = [b for b in bases if b not in batch_names and runner.repo_has(b)]
            repo_no = [b for b in bases if b not in batch_names and b not in repo_yes]
            batch_hit = [b for b in bases if b in batch_names]

            # ① 同批包名也无法满足 -> 版本约束过严, 放宽后重打包
            # 典型场景: A 依赖 B>=2.0, 但本批打的 B 是 1.9 — 同事务也解不了.
            # (1) even the batch cannot satisfy it -> version constraint too strict; relax and
            # repackage
            # typical case: A depends on B>=2.0, but the batch builds B 1.9 — even one transaction
            # cannot solve it.
            if batch_hit:
                affected = []
                relax = []
                for b in batch_hit:
                    if b in relaxed_deps:
                        continue
                    relaxed_deps.add(b)
                    for s in specs_with_dep(specs, b):
                        d = find_dep(s.meta, b)
                        if d and d.op:
                            relax.append(d)
                        if s not in affected:
                            affected.append(s)
                if relax:
                    for d in relax:
                        log.warn(f"依赖 {d.to_pacman()} 与同批包版本不符, 放宽为 {d.name}")
                        d.op = d.ver = None
                    for s in affected:
                        s.rebuild()
                    log.info("    已重新打包: " + ", ".join(s.meta.name for s in affected))
                    continue
                log.warn(f"依赖 {', '.join(batch_hit)} 指向同批包但版本约束仍不满足, 放弃安装")
                return False

            # ② 仓库有: 补装; 版本约束过严时放宽重打包
            # 判断依据: 首轮先补装; 若补装过 (need 为空) 仍报缺, 说明仓库版本
            # 不满足源包写的约束 (或依赖根本不在仓库), 此时才放宽.
            # (2) present in the repository: install; if the version is too strict, relax and
            # repackage
            # rationale: install first; if it was already installed (need is empty) but still
            # reported missing, the repo version
            # does not satisfy the constraint written by the source package (or the dep is not in
            # the repo); only then relax.
            if repo_yes:
                relax = []
                relax_specs = []
                for b in repo_yes:
                    if b in relaxed_deps:
                        continue
                    for s in specs_with_dep(specs, b):
                        d = find_dep(s.meta, b)
                        if d and d.op:
                            relax.append(d)
                        if s not in relax_specs:
                            relax_specs.append(s)
                # 已补装仍报缺 -> 版本不满足, 放宽重打包
                # already installed but still missing -> version mismatch; relax and repackage
                need = [b for b in repo_yes if b not in installed_deps]
                if relax and not need:
                    for d in relax:
                        relaxed_deps.add(d.name)
                        log.warn(f"依赖 {d.to_pacman()} 已补装仍不满足, 放宽为 {d.name}")
                        d.op = d.ver = None
                    for s in relax_specs:
                        s.rebuild()
                    log.info("    已重新打包: " + ", ".join(s.meta.name for s in relax_specs))
                    continue

                if need:
                    if opts.no_autodeps:
                        log.warn(f"缺失仓库依赖 {need}, 但已禁用自动补装 (--no-autodeps)")
                        return False
                    if not ask_confirm(opts, f"从仓库补装缺失依赖 (--asdeps): {', '.join(need)}?"):
                        return False
                    rc2, _out2 = runner.sync_asdeps(need)
                    if rc2 != 0:
                        log.warn("依赖补装失败, 放弃安装")
                        return False
                    installed_deps.update(need)
                    log.info(f"✓ 已补装依赖: {', '.join(need)}")
                    continue
                log.warn("仓库依赖均已尝试补装, 仍无法满足, 放弃安装")
                return False

            # ③ 仓库无: AUR 兜底 (--aur) -> 询问 yay/paru 补装
            # (3) not in the repository: AUR fallback (--aur) -> ask yay/paru to install
            if repo_no:
                aur_ok, aur_rest = try_aur_packages(repo_no, opts)
                if aur_ok:
                    log.info(f"下列依赖在 AUR 存在:")
                    for b, info in aur_ok:
                        log.info(f"    {b}  ({aur_summary(info)})")
                    if aur_helper_cmd() is None:
                        log.warn("未安装 yay/paru, 无法自动补装 AUR 依赖 (可: sudo pacman -S yay)")
                    elif ask_confirm(opts, f"用 AUR 助手补装上述 {len(aur_ok)} 个依赖 (--asdeps)?"
                                   + (" 将从源码构建, 耗时较长" if not opts.yes else ""),
                                   default=False):
                        names = [b for b, _ in aur_ok]
                        if aur_install(names, opts):
                            installed_deps.update(names)
                            log.info(f"✓ 已通过 AUR 补装: {', '.join(names)}")
                            continue
                        log.warn("AUR 补装失败, 回退到改名/移除流程")
                    else:
                        log.info("已跳过 AUR 补装, 进入改名/移除流程")
                action, affected = handle_unknown_deps(specs, aur_rest or repo_no, opts)
                if action == "rebuild":
                    for s in affected:
                        s.rebuild()
                        log.info(f"    已重新打包: {s.meta.name}")
                    continue
                return False

        # ---------- 其它失败 ----------
        # ---------- other failures ----------
        for n in diag["notes"]:
            log.warn(n)
        log.warn("安装失败且无法自动修复; 成品包保留: "
                 + ", ".join(s.pkgpath for s in specs))
        return False

    log.warn(f"达到最大重试次数 ({max_tries}), 安装仍未成功")
    return False


# ---------------------------------------------------------------------------
# --dry-run 安装计划预演: 依赖求解 + 文件冲突预检, 不执行任何安装
# --dry-run install plan: dependency solving + file-conflict pre-check, no installation
# ---------------------------------------------------------------------------

def local_db_files():
    """读 pacman 本地数据库 files 清单 -> {绝对路径: 包名}, 仅文件不含目录.

    数据库位置: <root>/var/lib/pacman/local/<pkgname-ver-rel>/files,
    其中 %FILES% 段每行一个相对路径 (目录以 '/' 结尾).
    包名从目录名 rsplit('-', 2) 推出 (name-version-rel); 包名本身含 '-' 时
    也能正确处理. 读不到 (测试隔离根尚未初始化) 时返回 None.

    Read the pacman local database files list -> {absolute path: package name},
    regular files only.

    Location: <root>/var/lib/pacman/local/<pkgname-ver-rel>/files, where the %FILES%
    section lists one relative path per line (directories end with '/').
    The package name is derived with rsplit('-', 2), which also works for names
    containing '-'. Returns None when unreadable (e.g. an uninitialized test root).
    """
    root = os.environ.get("ALLTAP_PACMAN_ROOT", "")
    dbdir = os.path.join(root or "/", "var", "lib", "pacman", "local")
    if not os.path.isdir(dbdir):
        return None
    owned = {}
    for fdir in _glob.glob(os.path.join(dbdir, "*", "files")):
        pkg = os.path.basename(os.path.dirname(fdir))
        try:
            with open(fdir, encoding="utf8", errors="replace") as f:
                started = False
                for line in f:
                    line = line.rstrip("\n")
                    if line.startswith("%"):
                        started = ("FILES" in line)
                        continue
                    if not started or not line or line.endswith("/"):
                        continue
                    owned.setdefault("/" + line, pkg.rsplit("-", 2)[0] if pkg.count("-") >= 2 else pkg)
        except OSError:
            continue
    return owned or None


def dry_run_report(specs, runner, opts):
    """输出安装计划 (补装哪些依赖 / 覆盖哪些文件 / 哪些需人工决断), 不改动系统.

    只读操作: pacman -T / -Si + 本地数据库文件比对; 不调用任何会写盘的命令.
    产生的计划同时落盘到 <output>/alltap-plan.txt, 便于事后对照/审批.

    已知局限: 文件冲突预检只能比对本地 pacman 数据库, 无法发现
    "不属于任何包的散落文件"以及符号链接目录下的内容.

    Print an install plan (dependencies to install / files to overwrite / items
    needing a decision) without changing the system.

    Read-only: pacman -T / -Si plus local database comparison; no writing command.
    The plan is also saved to <output>/alltap-plan.txt for later review/approval.

    Limitation: file-conflict pre-check only compares against the local pacman
    database; loose files not owned by any package and content under symlinked
    directories cannot be detected.
    """
    lines = []
    emit = lines.append
    emit("=" * 62)
    emit(f"alltap 安装计划 (--dry-run, 未实际执行)  {time.strftime('%Y-%m-%d %H:%M')}")
    emit("=" * 62)
    emit("")
    emit(f"待安装包 ({len(specs)} 个):")
    for s in specs:
        meta = s.meta
        emit(f"  • {meta.name} {meta.fullver}  [{meta.arch}]  <- {os.path.basename(s.srcfile)}")
    batch_names = batch_provided_names(specs)

    # --- 依赖求解: 同批提供 / pacman -T 缺失 / 仓库可补 / 需人工 ---
    # --- dependency solving: provided by batch / missing per pacman -T / installable from repo /
    # manual ---
    sched_deps = []
    for s in specs:
        for d in s.meta.depends:
            key = d.to_pacman()
            if key not in sched_deps:
                sched_deps.append(key)
    # 剔除同批可满足的 (pacman -U 同一事务自动解决)
    # drop the ones satisfied by this batch (pacman -U resolves them in one transaction)
    cross = sorted({dep_base_name(d) for d in sched_deps if dep_base_name(d) in batch_names})
    check = [d for d in sched_deps if dep_base_name(d) not in batch_names]

    emit("")
    if cross:
        emit(f"依赖由同批包互相提供 (同一 pacman -U 事务自动满足): {', '.join(cross)}")
    if not sched_deps:
        emit("依赖: 无")
    elif check:
        emit("依赖求解 (pacman -T 检查当前系统):")
        rc, out = runner.query(["-T"] + check, quiet=True) if check else (0, "")
        missing = [l.strip() for l in out.splitlines() if l.strip()] if rc == 127 else []
        if rc not in (0, 127):
            emit(f"  ! 无法执行 pacman -T (返回码 {rc}), 依赖求解跳过")
            missing = None
        if missing is not None and rc == 0:
            emit("  ✓ 全部依赖已满足, 无需补装")
        elif missing is not None:
            repo_plan, ask_plan, aur_plan = [], [], []
            # pacman -T 的输出可能带版本约束 (如 "foo>=1.2"), 查仓库时必须用基名
            # pacman -T output may contain version constraints (e.g. "foo>=1.2"); use the base name
            # when querying the repo
            for miss in missing:
                b = dep_base_name(miss)
                if not b or b in repo_plan or b in ask_plan:
                    continue
                if runner.repo_has(b):
                    repo_plan.append(b)
                else:
                    ask_plan.append(b)
            if opts.aur and ask_plan:
                for b in ask_plan:
                    st, info = aur_lookup(b)
                    if st == "found":
                        aur_plan.append((b, info))
                ask_plan = [b for b in ask_plan if b not in {n for n, _ in aur_plan}]
            if repo_plan:
                emit(f"  → 将从仓库补装 (--asdeps): {', '.join(repo_plan)}")
            for b, info in aur_plan:
                emit(f"  → AUR 可补装 (需确认): {b}  ({aur_summary(info)})")
            if ask_plan:
                emit(f"  ! 仓库无对应依赖, 需人工决断 (改名/移除/AUR): {', '.join(ask_plan)}")
                emit("    安装时若选择移除, 可能导致运行时缺库")

    # --- 文件冲突预检: 与本地数据库已登记文件比对 ---
    # --- file-conflict pre-check: compare with files registered in the local database ---
    emit("")
    owned = local_db_files()
    conflicts = []
    if owned is None:
        emit("文件冲突预检: 跳过 (本地 pacman 数据库不可读或为空)")
    else:
        for s in specs:
            for root_dir, _dirs, files in os.walk(s.tree_dir):
                for fn in files:
                    rel = os.path.relpath(os.path.join(root_dir, fn), s.tree_dir)
                    path = "/" + rel
                    if path in owned:
                        conflicts.append((s.meta.name, path, owned[path]))
        if conflicts:
            emit(f"文件冲突预检: {len(conflicts)} 个文件已被其它包占用, 安装时将询问 --overwrite:")
            for pkgname, path, owner in conflicts[:40]:
                emit(f"  ! {path}  ({pkgname} 与已装 {owner} 冲突)")
            if len(conflicts) > 40:
                emit(f"    ... 共 {len(conflicts)} 个")
        else:
            emit("文件冲突预检: 与已装包无文件冲突")
        # 提醒: 不受 pacman 管理的落盘文件无法静态预检
        # note: loosely dropped files not owned by any package cannot be pre-checked statically
    emit("  (注: 不属于任何包的散落文件冲突无法静态预检, 以实际安装为准)")

    # --- 脚本提醒 ---
    # --- script reminder ---
    scripted = [s.meta.name for s in specs if s.meta.scripts and "__raw__" not in s.meta.scripts]
    if scripted:
        emit("")
        emit(f"⚠ 以下包携带维护脚本, 安装时将以 root 执行: {', '.join(scripted)}")

    plan = "\n".join(lines)
    print()
    print(plan)
    planfile = os.path.join(opts.output, "alltap-plan.txt")
    try:
        with open(planfile, "w", encoding="utf8") as f:
            f.write(plan + "\n")
        log.info(f"\n✓ 安装计划已写入: {planfile}")
    except OSError as e:
        log.warn(f"计划文件写入失败: {e}")
    log.info("  此为 --dry-run 预演, 未执行任何安装; 确认后可去掉 --dry-run 实际安装")
    return True



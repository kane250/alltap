# RPM 解析 — lead + 签名 header + 主 header + payload
# ---------------------------------------------------------------------------

RPM_TAGS = {
    "NAME": 1000, "VERSION": 1001, "RELEASE": 1002, "EPOCH": 1003,
    "SUMMARY": 1004, "DESCRIPTION": 1005, "LICENSE": 1014, "PACKAGER": 1015,
    "URL": 1020, "ARCH": 1022,
    "PREIN": 1023, "POSTIN": 1024, "PREUN": 1025, "POSTUN": 1026,
    "SOURCERPM": 1044, "RPMVERSION": 1064,
    "PROVIDENAME": 1047, "REQUIREFLAGS": 1048, "REQUIRENAME": 1049,
    "REQUIREVERSION": 1050,
    "CONFLICTFLAGS": 1053, "CONFLICTNAME": 1054, "CONFLICTVERSION": 1055,
    "OBSOLETENAME": 1090, "PROVIDEFLAGS": 1112, "PROVIDEVERSION": 1113,
    "OBSOLETEFLAGS": 1114, "OBSOLETEVERSION": 1115,
    "PAYLOADFORMAT": 1124, "PAYLOADCOMPRESSOR": 1125,
    "PRETRANS": 1151, "POSTTRANS": 1152,
    "PREINPROG": 1085, "POSTINPROG": 1086, "PREUNPROG": 1087, "POSTUNPROG": 1088,
    "RECOMMENDNAME": 5046, "RECOMMENDFLAGS": 5048, "RECOMMENDVERSION": 5047,
    "SUGGESTNAME": 5049,
}
T = RPM_TAGS


def _rpm_read_header(f) -> Tuple[list, bytes]:
    """从文件流读一个 RPM header(内部工具, 调试用)"""
    magic = f.read(8)
    if magic != b"\x8e\xad\xe8\x01\x01\x00\x00\x00":
        raise ValueError("非法 RPM header magic")
    (nindex, hsize) = struct.unpack(">II", f.read(8))
    entries = []
    for _ in range(nindex):
        tag, typ, off, cnt = struct.unpack(">IIII", f.read(16))
        entries.append((tag, typ, off, cnt))
    store = f.read(hsize)
    return entries, store


def _rpm_entry_value(typ, cnt, off, store):
    """按 rpm tag 类型从 store 中读取值 (offset 由 writer 按类型对齐)"""
    if typ in (6, 8, 9):    # STRING / STRING_ARRAY / I18NSTRING
        vals = []
        p = off
        n = 1 if typ == 6 else cnt
        for _ in range(n):
            e = store.find(b"\0", p)
            vals.append(store[p:e].decode("utf8", "replace"))
            p = e + 1
        return vals[0] if typ == 6 else vals
    if typ == 1:
        return store[off:off + cnt]
    if typ == 2:   # CHAR / int8
        return list(store[off:off + cnt])
    if typ == 3:
        return list(struct.unpack(f">{cnt}h", store[off:off + cnt * 2]))
    if typ == 4:
        return list(struct.unpack(f">{cnt}i", store[off:off + cnt * 4]))
    if typ == 5:
        return list(struct.unpack(f">{cnt}q", store[off:off + cnt * 8]))
    if typ == 7:   # BIN
        return store[off:off + cnt]
    raise ValueError(f"未知 rpm tag 类型 {typ}")


class RpmInfo:
    def __init__(self, fields, payload_to, compressor):
        self.f = fields                       # {tag号: 值}
        self.payload_to = payload_to          # callable(dest) -> 解出文件数量
        self.compressor = compressor


def parse_rpm(path: str) -> RpmInfo:
    """lead(96) + 签名 header(按 8 字节对齐) + 主 header + 压缩 cpio payload"""
    import io
    data = open(path, "rb").read()
    if data[:4] != b"\xed\xab\xee\xdb":
        raise ValueError("非法 RPM lead magic")
    pos = 96  # lead 长度固定 96

    def read_header(pos0):
        magic = data[pos0:pos0 + 4]   # rpm 4.24+ 尾部 version/reserved 字节有差异, 只校验前 4 字节
        if magic != b"\x8e\xad\xe8\x01":
            raise ValueError("非法 RPM header magic")
        nindex, hsize = struct.unpack(">II", data[pos0 + 8:pos0 + 16])
        entries = []
        p = pos0 + 16
        for _ in range(nindex):
            tag, typ, off, cnt = struct.unpack(">IIII", data[p:p + 16])
            entries.append((tag, typ, off, cnt))
            p += 16
        store = data[p:p + hsize]
        return entries, store, p + hsize

    # 签名 header 后按 8 字节(绝对文件偏移)对齐到主 header
    _se, _ss, spos = read_header(pos)
    spos += (8 - (spos % 8)) % 8
    entries, store, pend = read_header(spos)

    fields = {}
    for (tag, typ, off, cnt) in entries:
        try:
            fields[tag] = _rpm_entry_value(typ, cnt, off, store)
        except Exception as e:
            log.verb(f"rpm tag {tag} 解析失败: {e}")

    compressor = fields.get(T["PAYLOADCOMPRESSOR"], "gzip")
    payload_raw = data[pend:]

    def payload_to(dest: str) -> int:
        if compressor == "gzip":
            stream = gzip.GzipFile(fileobj=io.BytesIO(payload_raw))
        elif compressor in ("xz", "lzma"):
            stream = lzma.LZMAFile(io.BytesIO(payload_raw))
        elif compressor == "bzip2":
            stream = bz2.BZ2File(io.BytesIO(payload_raw))
        elif compressor.startswith("zstd"):
            if not which("zstd"):
                die("RPM payload 为 zstd 压缩, 需要 zstd 工具")
            proc = subprocess.Popen(["zstd", "-dc"], stdin=subprocess.PIPE,
                                    stdout=subprocess.PIPE)
            out, _ = proc.communicate(payload_raw)
            stream = io.BytesIO(out)
        else:
            die(f"不支持的 RPM payload 压缩: {compressor}")
        return extract_cpio_newc(stream, dest)

    return RpmInfo(fields, payload_to, compressor)


# rpm 依赖 flags (rpmds.h)
RPMSENSE_LESS, RPMSENSE_GREATER, RPMSENSE_EQUAL = 2, 4, 8


def rpm_sense_to_op(flags: int) -> Optional[str]:
    s = flags & 0xF
    if s == RPMSENSE_EQUAL:
        return "="
    if s == RPMSENSE_LESS:
        return "<"
    if s == RPMSENSE_GREATER:
        return ">"
    if s == (RPMSENSE_LESS | RPMSENSE_GREATER):
        return None   # <> 范围, pacman 无法表达, 视作无版本
    if s == (RPMSENSE_LESS | RPMSENSE_EQUAL):
        return "<="
    if s == (RPMSENSE_GREATER | RPMSENSE_EQUAL):
        return ">="
    return None

# ---------------------------------------------------------------------------
# 格式探测
# ---------------------------------------------------------------------------

def detect_format(path: str) -> str:
    fn = os.path.basename(path).lower()
    with open(path, "rb") as f:
        head = f.read(0x4000)

    # --- magic 判定优先 ---
    if head.startswith(b"\xed\xab\xee\xdb"):
        return "rpm"
    if head[:8] == b"!<arch>\n":
        return "deb"
    # .dtb? no. Alpine apk: gzip 流且成员名以 .PKGINFO/.SIGN 开头
    is_gz = head[:2] == b"\x1f\x8b"
    is_xz = head[:6] == b"\xfd7zXZ\x00"
    is_bz2 = head[:3] == b"BZh"
    is_zst = head[:4] == b"\x28\xb5\x2f\xfd"

    # AppImage: ELF 且文件名 .AppImage
    if head[:4] == b"\x7fELF" and fn.endswith(".appimage"):
        return "appimage"

    if is_gz or is_xz or is_bz2 or is_zst or head[:8] == b"ustar  \0" or head[:8] == b"ustar\x0000":
        if fn.endswith(".apk"):
            return "apk"
        # Arch 包按文件名优先判定 (避免与 apk 的 .PKGINFO 首成员混淆)
        if fn.endswith((".pkg.tar.zst", ".pkg.tar.xz", ".pkg.tar.gz", ".pkg.tar")):
            return "archpkg"
        # 看归档首条目判断类型
        names = []
        try:
            names = bsdtar_list(path)
        except Exception:
            pass
        firsts = {os.path.basename(n) for n in names[:8]}
        apk_like = any(n.startswith(".SIGN.") for n in names[:8]) or (
            ".PKGINFO" in firsts and names[:1] and names[0] == ".PKGINFO")
        arch_like = ".MTREE" in firsts or ".MTREE" in names[:3]
        if arch_like:
            return "archpkg"
        if apk_like:
            return "apk"
        if any(n.split("/")[0] == "install" for n in names) and re.search(r"-[^-]+-[^-]+-\d+\.(tgz|txz)$", fn, re.I):
            return "slack"
        # tarball: 系统树 or 普通归档
        return "tarball"
    if head == b"" :
        die(f"空文件: {path}")
    # 未压缩 tar?
    if head[:8] in (b"ustar  \0", b"ustar\x0000"):
        return "tarball"
    if fn.endswith(".appimage"):
        return "appimage"
    die(f"无法识别的包格式: {path}\n支持: .deb .rpm .apk .tgz/.txz .AppImage .tar.* .pkg.tar.zst")


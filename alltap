class Log:
    def __init__(self):
        self.quiet = False
        self.verbose = False

    def info(self, msg):
        if not self.quiet:
            print(msg)

    def verb(self, msg):
        if self.verbose and not self.quiet:
            print("    " + msg)

    def warn(self, msg):
        if not self.quiet:
            print(f"  警告: {msg}", file=sys.stderr)

    def drop_list(self, kind, items):
        """收集被丢弃/未翻译的条目, 退出前统一提示"""
        if items and not self.quiet:
            print(f"  注意: 以下 {kind} 已被{ '剔除' if kind.startswith('依赖') else '忽略' }: {', '.join(sorted(set(items)))}")

log = Log()


def die(msg, code=1):
    print(f"错误: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd, **kw):
    """执行外部命令, 失败抛异常"""
    log.verb("$ " + " ".join(cmd))
    return subprocess.run(cmd, check=True, capture_output=True, text=False, **kw)


def which(cmd):
    return shutil.which(cmd) is not None


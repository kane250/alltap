def bsdtar_extract(archive: str, dest: str, exclude_prefixes: List[str] = None):
    """用 bsdtar 解包到 dest (自动创建).

    选 bsdtar 而不是 tarfile: 它一个工具同时支持 tar/gzip/xz/bzip2/zstd/ar,
    且对权限位/符号链接/硬链接的处理与 makepkg 一致. exclude_prefixes
    用于排除包管理器元文件目录.

    Extract an archive with bsdtar into dest (created automatically).

    bsdtar handles tar/gzip/xz/bzip2/zstd/ar in one tool and preserves permission
    bits, symlinks and hardlinks the same way makepkg does.
    """
    if not which("bsdtar"):
        die("缺少 bsdtar (libarchive), 请先安装: sudo pacman -S libarchive")
    os.makedirs(dest, exist_ok=True)
    cmd = ["bsdtar", "-xf", archive, "-C", dest]
    for ex in (exclude_prefixes or []):
        cmd += ["--exclude", ex]
    run(cmd)


def bsdtar_list(archive: str) -> List[str]:
    """列出归档成员路径 (不解包), 用于格式探测与顶层目录推断.

    输出可能包含目录条目 (以 / 结尾) 与重复名, 由调用方自行处理.

    List archive member paths without extracting (used by format detection and
    top-level directory inference). Directory entries end with '/' and names may
    repeat; callers handle both.
    """
    out = run(["bsdtar", "-tf", archive])
    return [ln for ln in out.stdout.decode("utf8", "replace").splitlines() if ln.strip()]

# ---------------------------------------------------------------------------
# cpio(newc) 解析 — 用于 RPM payload, 纯 Python
# cpio(newc) parsing — pure Python, for the RPM payload
# ---------------------------------------------------------------------------

CPIO_MAGIC = (b"070701", b"070702")


def extract_cpio_newc(stream, destdir: str):
    """把已解压的 cpio(newc) 字节流解到 destdir, 返回处理的条目数.

    头固定 110 字节: 6 字节 magic (070701/070702) + 13×8 字节十六进制字段.
    对齐规则的关键点: 名称区从偏移 110 开始, 所以名称的填充按
    (110 + namesize) 对 4 取模; 而文件数据的填充按 filesize 单独取模.
    这两处对齐算错是解析 cpio 最常见的翻车点.

    安全性: 拒绝含 '..' 的路径 (防 tar-slip 式穿越); 且以 lstrip("./") 去掉
    rpm 常见的 "./" 前缀, 保证落盘位置始终在 destdir 下.
    设备/管道/套接字等非常规类型直接跳过 (Arch 包不应携带它们).

    Extract a decompressed cpio(newc) byte stream into destdir; returns entry count.

    Header: 110 bytes = 6-byte magic (070701/070702) + 13 x 8 hex fields.
    Alignment trap: the name area starts at offset 110, so name padding is based on
    (110 + namesize) mod 4, while file data padding is based on filesize mod 4.

    Safety: reject paths containing '..' (tar-slip style traversal) and strip the
    leading './' that rpm payloads commonly use, so writes stay under destdir.
    Devices/FIFOs/sockets are skipped because Arch packages must not carry them.
    """
    count = 0
    while True:
        hdr = stream.read(110)
        if len(hdr) < 110:
            break
        if hdr[:6] not in CPIO_MAGIC:
            raise ValueError(f"非法 cpio 头: {hdr[:6]!r}")
        f = [int(hdr[6 + i * 8: 6 + (i + 1) * 8], 16) for i in range(13)]
        (_ino, mode, _uid, _gid, _nlink, _mtime, filesize,
         _devmaj, _devmin, _rmaj, _rmin, namesize, _chk) = f
        name = stream.read(namesize - 1).decode("utf8", "replace")
        stream.read(1)  # NUL
                        # NUL terminator
        pad = (110 + namesize) & 3
        if pad:
            stream.read(4 - pad)
        data = stream.read(filesize)
        pad = filesize & 3
        if pad:
            stream.read(4 - pad)
        if name == "TRAILER!!!":
            break
        # 防路径穿越
        # prevent path traversal
        name = name.lstrip("./")
        if not name or ".." in name.split("/"):
            continue
        target = os.path.join(destdir, name)
        ftype = mode & 0o170000
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if ftype == 0o040000:                       # 目录
                                                    # directory
            os.makedirs(target, exist_ok=True)
        elif ftype == 0o120000:                     # 符号链接
                                                    # symlink
            linkto = data.decode("utf8", "replace")
            if os.path.lexists(target):
                os.remove(target)
            os.symlink(linkto, target)
        elif ftype == 0o100000:                     # 普通文件
                                                    # regular file
            with open(target, "wb") as fp:
                fp.write(data)
            # 恢复权限位 (去掉高位类型位)
            # restore permission bits (strip the high type bits)
            try:
                os.chmod(target, mode & 0o7777)
            except OSError:
                pass
        else:                                        # 设备/管道/套接字: 忽略
                                                     # device/fifo/socket: skip
            log.verb(f"跳过非常规 cpio 条目: {name} (type={oct(ftype)})")
        count += 1
    return count


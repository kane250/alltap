def load_rules(path: str):
    """解析映射表, 返回 (plain, regexes, drops) 三部分规则.

    语法:
      '原名 => arch名'          精确映射, 右值空表示丢弃
      '@regex 正则 => arch名'   正则映射 (re.match, 即从行首开始匹配)
      '@drop 名 [名...]'        直接丢弃名单
      '#' 开头为注释; 空行忽略

    返回: plain={原名: 新名或""}, regexes=[(编译后正则, 新名或"")], drops={名}
    注意 plain 与 drops 分开存放, 查询时 _lookup 先看 plain 再回退 drops.

    Parse the mapping table into (plain, regexes, drops).

    Syntax:
      'name => arch-name'          exact mapping; empty rhs means drop
      '@regex pattern => arch-name' regex mapping (re.match, i.e. anchored at start)
      '@drop name [name...]'        explicit drop list
      '#' starts a comment; blank lines ignored

    plain and drops are kept separately; _lookup checks plain first, then drops.
    """
    plain, regexes, drops = {}, [], set()
    text = open(path, encoding="utf8").read() if path else EMBEDDED_MAP
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("@drop"):
            for x in line.split()[1:]:
                drops.add(x.strip("'\""))
            continue
        if line.startswith("@regex"):
            body = line[len("@regex"):].strip()
            m = re.match(r"^(.*?)\s*=>\s*(.*)$", body)
            if m:
                regexes.append((re.compile(m.group(1)), m.group(2).strip().strip("'\"")))
            continue
        m = re.match(r"^(\S+)\s*(?:=>\s*(\S*))$", line)
        if m:
            plain[m.group(1)] = (m.group(2) or "").strip()
    return plain, regexes, drops


ARCH_REPOS_CACHE = None

def arch_repo_names() -> set:
    """当前系统仓库 (官方仓库, 不含 AUR) 的全部包名, 结果进程内缓存.

    两级缓存: 内存 (ARCH_REPOS_CACHE) + 磁盘 (~/.cache/alltap/arch-repo-names.txt, 7 天).
    磁盘缓存的意义: 每次启动都要建索引, pacman -Slq 在慢盘上可达数百毫秒;
    7 天过期是为了兼顾"新包能被识别"与"不频繁调用 pacman".
    pacman 不存在或执行失败时返回空集 — 此时 _lookup 只能靠映射表与启发式规则,
    未识别依赖会明显变多, 属于非 Arch 系统上运行时的预期行为.

    All package names in the current official repositories (not AUR), cached in-process.

    Two-level cache: memory (ARCH_REPOS_CACHE) and disk
    (~/.cache/alltap/arch-repo-names.txt, 7 days). The disk cache avoids a slow
    pacman -Slq on every start while still picking up new packages within a week.
    Returns an empty set when pacman is missing or fails; then _lookup relies only
    on mappings and heuristics, which is expected on non-Arch systems.
    """
    global ARCH_REPOS_CACHE
    if ARCH_REPOS_CACHE is not None:
        return ARCH_REPOS_CACHE
    cache = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
                         "alltap", "arch-repo-names.txt")
    names = set()
    try:
        if os.path.exists(cache) and time.time() - os.path.getmtime(cache) < 7 * 86400:
            names = set(open(cache).read().split())
        elif which("pacman"):
            out = subprocess.run(["pacman", "-Slq"], capture_output=True, text=True)
            if out.returncode == 0:
                names = set(out.stdout.split())
                os.makedirs(os.path.dirname(cache), exist_ok=True)
                open(cache, "w").write("\n".join(sorted(names)))
    except Exception as e:
        log.verb(f"获取 Arch 仓库包名失败: {e}")
    ARCH_REPOS_CACHE = names
    return names


class Translator:
    """源发行版依赖 -> Arch 包名的翻译器 (每进程一个, 每处理一个文件 reset 一次).

    规则链 (见 _lookup):
      1. 映射表精确项 / 丢弃名单
      2. 映射表正则项
      3. 与当前 Arch 仓库同名 -> 直接使用
      4. 库名变形启发式 (去 soname 版本号、去 -dev/-devel 后缀、去 lib 前缀)
    全部未命中则记入 unresolved, 由 keep_unknown_deps 决定保留还是剔除.

    三个日志列表贯穿一次转换: translated/unresolved/droplog,
    后者用于退出前统一提示, 避免逐条刷屏.

    Translator from source-distro dependency names to Arch package names.

    Rule chain (see _lookup):
      1. exact entries / drop list in the map
      2. regex entries in the map
      3. same name exists in the Arch repositories
      4. library-name heuristics (strip soname version, -dev/-devel suffix, lib prefix)

    Unresolved names go to ``unresolved`` and are kept or dropped according to
    --keep-unknown-deps. The three lists (translated/unresolved/droplog) cover one
    conversion and are reset per input file.
    """

    def __init__(self, opts):
        self.opts = opts
        mfile = find_map_file()
        self.plain, self.regexes, self.drops = load_rules(mfile)
        if not mfile:
            log.verb("使用内嵌最小映射表 (未找到 data/dep-map.conf)")
        self.repo = arch_repo_names()
        self.unresolved = []
        self.droplog = []
        self.translated = []

    # ---- 规则链 ----
    # ---- rule chain ----
    def _lookup(self, name: str) -> Optional[str]:
        """把单个源依赖名解析为 Arch 包名; 返回 None 表示"应丢弃/无法翻译".

        注意与 translate() 的分工: 本函数只做"名字 -> 名字"的纯映射,
        不记录日志、不决定未识别依赖的去留. 调用方 (translate) 才拥有策略权.
        返回空字符串与 None 语义相同 (映射表右值留空 = 丢弃).

        Resolve one source dependency name to an Arch package name; None means
        "drop / cannot translate".

        Division of labor: this function is a pure name->name mapping and does not log
        or decide the fate of unknown dependencies; translate() owns that policy.
        An empty string and None have the same meaning (empty rhs in the map = drop).
        """
        # 1. 显式映射
        # 1. explicit mapping
        if name in self.plain:
            return self.plain[name] or None    # 空值 = 丢弃
                                               # empty value = drop
        if name in self.drops:
            return None
        # 2. 正则
        # 2. regular expressions
        for rx, dest in self.regexes:
            if rx.match(name):
                return dest or None
        # 3. 直接与 Arch 仓库同名
        # 3. same name already exists in the Arch repositories
        if name in self.repo:
            return name
        # 4. lib 前缀/soname 后缀变形
        # 4. lib-prefix / soname suffix transformations
        cands = []
        # 4a. libfoo1.2 / libfoo1.2-3 -> libfoo (去 soname 版本号)
        # 4a. libfoo1.2 / libfoo1.2-3 -> libfoo (strip soname version)
        m = re.match(r"^(lib[^-]+?)[0-9]+([.][0-9.]+)?([-+].*)?$", name)
        if m:
            base = m.group(1)
            cands += [base]
        # 4b. 去 -dev/-devel/-doc/-common/-bin 后缀; -dev/-devel 额外尝试带 lib 前缀形式
        # 4b. strip -dev/-devel/-doc/-common/-bin suffixes; for -dev/-devel also try the
        # lib-prefixed form
        m2 = re.match(r"^(lib)?(.+?)(-dev|-devel|-doc|-docs|-common|-bin)?$", name)
        if m2:
            core = m2.group(2)
            if m2.group(3) == "-dev" or m2.group(3) == "-devel":
                cands += [core, m2.group(1) + core if m2.group(1) else core]
            else:
                cands += [core]
        # 4c. soname: libfoo.so.5 -> libfoo / foo
        m3 = re.match(r"^(lib[^.]+)\.so(\.[0-9.]+)?$", name)
        if m3:
            lib = m3.group(1)
            cands = [lib, lib[3:] if lib.startswith("lib") else lib] + cands
        for c in cands:
            if not c or len(c) <= 2:       # 过短的候选名极易误匹配, 直接跳过
                                           # very short candidates match too easily; skip them
                continue
            if c in self.plain:
                return self.plain[c] or None
            if c in self.repo:
                return c
            # 再试 去 lib
            # try again with the lib prefix removed
            if c.startswith("lib") and len(c) > 5:
                c2 = c[3:]
                if c2 in self.plain:
                    return self.plain[c2] or None
                if c2 in self.repo:
                    return c2
        return None

    def translate(self, dep: Dep, ctx: str) -> Dep:
        """翻译单条依赖; 无法翻译时按 --keep-unknown-deps 决定去留.

        ctx 是源格式 (deb/rpm/apk...), 目前只用于 deb 特有的基础设施包丢弃.
        返回 None 表示"调用方应丢弃此依赖", 返回 Dep 表示可用 (可能原名保留).

        顺序上的一个细节: drops (映射表显式丢弃) 先于 DEB_TRASH 判断,
        所以映射表里的 @drop 能覆盖代码内置的垃圾名单.

        Translate one dependency; unresolved ones are kept or dropped according to
        --keep-unknown-deps.

        ctx is the source format (deb/rpm/apk...), currently used only for the
        deb-specific infrastructure drop set. None means "caller should drop it";
        a Dep means usable (possibly kept under its original name).

        Ordering detail: drops (explicit @drop in the map) are checked before
        DEB_TRASH, so map-level drops override the built-in list.
        """
        name = dep.name
        if name in self.drops:
            self.droplog.append(name)
            return None
        if ctx == "deb" and name in DEB_TRASH:
            self.droplog.append(name)
            return None
        newname = self._lookup(name)
        if newname:
            nd = Dep(newname, dep.op, dep.ver)
            if newname != name:
                self.translated.append(f"{name}->{newname}")
            else:
                self.translated.append(f"{name}(同名直用)")
            return nd
        # 去留由 opts.keep_unknown_deps 决定, 记录里只保留原始依赖名,
        # 避免输出与报告出现 "(保留原样)" 之类的重复注解
        # whether to keep unknown deps is decided by opts.keep_unknown_deps; the log keeps only the
        # original name,
        # avoid duplicate annotations such as "(kept as-is)" in output and reports
        self.unresolved.append(name)
        return dep if self.opts.keep_unknown_deps else None

    def reset(self):
        """清空三份日志 — 必须在处理每个新输入文件前调用, 否则报告串包.

        Clear the three logs — must be called before each new input file, otherwise
        reports bleed across packages.
        """
        self.unresolved = []
        self.droplog = []
        self.translated = []


# 各源依赖的"垃圾名单"
# RPM 的 Requires 里混有大量非包名条目: rpmlib(...) 是 rpm 自身能力,
# config(...) 是配置文件能力, /bin/sh 这类绝对路径依赖, 以及 soname 依赖.
# Arch 用包名而不是 soname 追踪依赖, 因此 soname 一律丢弃 (否则会造出假依赖).
# garbage lists for each source format
# RPM Requires contains many non-package entries: rpmlib(...) is an rpm capability,
# config(...) is a config-file capability, /bin/sh is an absolute-path dependency, plus soname
# dependencies.
# Arch tracks dependencies by package name, not soname, so sonames are always dropped (otherwise
# they become bogus deps).
RPM_GARBAGE = [
    re.compile(r"^rpmlib\(.*"), re.compile(r"^rtld\([^)]*\)$"),
    re.compile(r"^config\([^)]*\)$"), re.compile(r"^/.*"),           # /bin/sh 等
    # such as /bin/sh
    re.compile(r".*\.so(\.[0-9]+)*(\([^)]*\))*$"),       # soname 含 GLIBC 版本标记/64bit
    # soname contains GLIBC version markers / 64bit
    re.compile(r"^objfmt\("), re.compile(r"^elf\("),
    re.compile(r"^python\(abi\)"), re.compile(r"^perl\("), re.compile(r"^ruby\("),
    re.compile(r"^bundled\("), re.compile(r"^debuginfod\("),
    re.compile(r"^[A-Za-z0-9._+-]+\((x86-64|x86|aarch64|i686|ppc64le|s390x|riscv64)\)$"),  # 架构虚拟 provides
    # architecture virtual provides
]

DEB_TRASH = {  # 这些是发行版基础设施包, Arch 无对应概念, deb 特有丢弃集
               # these are distro infrastructure packages with no Arch counterpart; deb-specific drop set
    "debconf", "debconf-2.0", "dpkg", "install-info", "libc-bin", "init-system-helpers",
    "base-files", "adduser", "usr-is-merged", "coreutils", "bash", "dash", "mount",
    "passwd", "passwd:", "libsasl2-modules", "systemd-sysv", "sysvinit-utils",
    "lsb-base", "libgcc-12-base", "gcc-12-base", "gcc-13-base",
    "ucf", "mime-support", "media-types", "x11-common", "shared-mime-info",
}

APK_TRASH_RE = [
    re.compile(r"^so:.*"), re.compile(r"^cmd:.*"),
]


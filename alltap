@dataclass
class Dep:
    """一条依赖: name + 可选比较符/版本.

    内部统一用"拆开"的三元组表示, 输出时再拼成 pacman 的 name<op>ver,
    好处是修复循环里可以只改 op/ver (放宽版本) 而不动 name.
    op 为空表示不约束版本; ver 仅在 op 非空时有意义.

    One dependency: name plus optional comparison operator and version.

    The three fields are kept separate so the repair loop can relax only the
    operator/version without touching the name.
    """
    name: str
    op: Optional[str] = None    # < <= = >= >
    ver: Optional[str] = None

    def to_pacman(self):
        """拼成 .PKGINFO / pacman -U 接受的依赖串, 如 glibc>=2.38.

        Render the pacman dependency string, e.g. glibc>=2.38.
        """
        return f"{self.name}{self.op or ''}{self.ver or ''}"


@dataclass
class Metadata:
    """源包元数据的统一中间表示 (所有 handler 的唯一产物形式).

    字段命名对齐 Arch: version 与 release 分开存放, fullver 负责拼成
    "epoch:version-release"; pkgfilename 直接生成 makepkg 风格文件名.
    scripts 的键是 .INSTALL 里的函数名 (post_install 等), 特殊键 __raw__
    表示 Arch 包重打包时原样保留的 .INSTALL 全文.

    Unified intermediate representation of source package metadata.

    Field names follow Arch conventions: version and release are stored separately
    and fullver joins them as "epoch:version-release". Keys in scripts are .INSTALL
    function names; the special key __raw__ keeps an original .INSTALL verbatim.
    """

    name: str = "unknown"
    epoch: str = ""
    version: str = "1.0"
    release: str = "1"
    desc: str = "(无描述)"
    long_desc: str = ""
    arch: str = "x86_64"
    url: str = ""
    license: str = "unknown"
    depends: List[Dep] = field(default_factory=list)
    optdepends: List[str] = field(default_factory=list)   # 已是 "pkg: 说明" 形式
    # already in "pkg: description" form
    provides: List[str] = field(default_factory=list)
    conflicts: List[str] = field(default_factory=list)
    replaces: List[str] = field(default_factory=list)
    groups: List[str] = field(default_factory=list)
    scripts: Dict[str, str] = field(default_factory=dict)  # .INSTALL 函数名 -> 函数体
    # .INSTALL function name -> function body
    source_fmt: str = ""

    @property
    def fullver(self):
        """完整版本串 "[epoch:]version-pkgrel" — 用于 .PKGINFO 与文件名.

        Full version string "[epoch:]version-pkgrel" — used in .PKGINFO and filenames.
        """
        e = f"{self.epoch}:" if self.epoch else ""
        return f"{e}{self.version}-{self.release}"

    @property
    def pkgfilename(self):
        """makepkg 风格文件名: <name>-<fullver>-<arch>.pkg.tar.zst.

        makepkg-style filename: <name>-<fullver>-<arch>.pkg.tar.zst.
        """
        return f"{self.name}-{self.fullver}-{self.arch}.pkg.tar.zst"


def sanitize_pkgname(name: str) -> str:
    """把任意包名规范成 pacman 允许的字符集.

    规则: 小写; 空白转 '-'; 仅保留 [a-z0-9@._+-]; 去掉开头的 '.'/'-'
    (pkgname 不能以这两个字符开头). 结果为空时回退为 "pkg".

    Normalize an arbitrary package name to the character set pacman allows.

    Lowercase, whitespace to '-', keep [a-z0-9@._+-], strip leading '.'/'-'.
    Falls back to "pkg" when the result is empty.
    """
    n = name.lower().strip()
    n = re.sub(r"\s+", "-", n)
    n = re.sub(r"[^a-z0-9@._+\-]", "", n)
    n = n.lstrip(".-")
    return n or "pkg"


def sanitize_ver(v: str) -> str:
    """pacman:版本段不得含 '-', 允许 [A-Za-z0-9_.+:]; 不得以 '.'/'-' 开头

    pacman version segment: no '-', only [A-Za-z0-9_.+:], must not start with '.'/'-'.
    """
    v = v.strip().replace(" ", "_")
    v = re.sub(r"[^A-Za-z0-9_.+]", "_", v)
    v = v.lstrip(".-_")
    return v or "1"


def sanitize_rel(r: str) -> str:
    """pkgrel 规范化为 makepkg 要求的 integer[.integer];
    ubuntu 后缀(如 2ubuntu1)转成 2.1, 其余非数字字符丢弃

    Normalize pkgrel to the integer[.integer] form required by makepkg.

    Ubuntu suffixes such as 2ubuntu1 become 2.1; other non-digits are dropped.
    """
    r = r.strip()
    m = re.match(r"^(\d+)", r)
    if not m:
        return "1"
    main = m.group(1)
    rest = r[m.end():]
    mm = re.search(r"(\d+)", rest)
    sub = mm.group(1) if mm else ""
    return main + ("." + sub if sub else "")

# ---------------------------------------------------------------------------
# ar 归档解析 (用于 .deb)
# ar archive parsing (the outer container of .deb)
# ---------------------------------------------------------------------------

def parse_ar(path: str) -> List[Tuple[str, bytes]]:
    """解析 ar 归档 (.deb 的外层容器), 返回 [(成员名, 字节内容), ...] 保序.

    ar 格式要点:
      * 文件以全局 magic "!<arch>\\n" 开头;
      * 每个成员前有 60 字节 ASCII 头, 其中 [0:16] 名称, [48:58] 十进制大小;
      * 成员数据紧跟在头后, 若大小为奇数补 1 字节 '\\n' 对齐 (即 pos & 1);
      * 名称以 '/' 结尾是 GNU ar 的截断标记, 此处直接去掉.

    已知局限: 不支持 GNU 长名表 (//) 与 /<offset> 间接引用 — deb 的成员名
    (debian-binary/control.tar.*/data.tar.*) 都足够短, 不受影响.
    实现上整体读入内存: deb 通常几 MB~几十 MB, 可接受.

    Parse an ar archive (the outer container of .deb); returns ordered (name, bytes).

    ar layout: global magic "!<arch>\n"; each member has a 60-byte ASCII header
    with the name at [0:16] and the decimal size at [48:58]; odd-sized members are
    padded with one byte. A trailing '/' in the name is a GNU truncation marker.

    Limitation: GNU long-name tables (//) and /<offset> references are unsupported;
    deb member names are short enough and are unaffected. The whole file is read
    into memory, which is acceptable for typical debs.
    """
    data = open(path, "rb").read()
    if data[:8] != b"!<arch>\n":
        raise ValueError("不是合法的 ar 归档 (deb?)")
    members = []
    pos = 8
    while pos + 60 <= len(data):
        hdr = data[pos:pos + 60]
        name = hdr[0:16].decode("latin1").rstrip()
        name = name.rstrip("/")
        size = int(hdr[48:58].decode("latin1").split()[0])
        body = data[pos + 60: pos + 60 + size]
        members.append((name, body))
        pos += 60 + size
        if pos & 1:          # ar 成员按 2 字节对齐
                             # ar members are 2-byte aligned
            pos += 1
    return members


@dataclass
class Dep:
    """一条依赖: name + 可选比较符/版本"""
    name: str
    op: Optional[str] = None    # < <= = >= >
    ver: Optional[str] = None

    def to_pacman(self):
        return f"{self.name}{self.op or ''}{self.ver or ''}"


@dataclass
class Metadata:
    name: str = "unknown"
    epoch: str = ""
    version: str = "1.0"
    release: str = "1"
    desc: str = "(无描述)"
    long_desc: str = ""
    arch: str = "x86_64"
    url: str = ""
    license: str = "unknown"
    depends: List[Dep] = field(default_factory=list)
    optdepends: List[str] = field(default_factory=list)   # 已是 "pkg: 说明" 形式
    provides: List[str] = field(default_factory=list)
    conflicts: List[str] = field(default_factory=list)
    replaces: List[str] = field(default_factory=list)
    scripts: Dict[str, str] = field(default_factory=dict)  # .INSTALL 函数名 -> 函数体
    source_fmt: str = ""

    @property
    def fullver(self):
        e = f"{self.epoch}:" if self.epoch else ""
        return f"{e}{self.version}-{self.release}"

    @property
    def pkgfilename(self):
        return f"{self.name}-{self.fullver}-{self.arch}.pkg.tar.zst"


def sanitize_pkgname(name: str) -> str:
    n = name.lower().strip()
    n = re.sub(r"\s+", "-", n)
    n = re.sub(r"[^a-z0-9@._+\-]", "", n)
    n = n.lstrip(".-")
    return n or "pkg"


def sanitize_ver(v: str) -> str:
    """pacman:版本段不得含 '-', 允许 [A-Za-z0-9_.+:]; 不得以 '.'/'-' 开头"""
    v = v.strip().replace(" ", "_")
    v = re.sub(r"[^A-Za-z0-9_.+]", "_", v)
    v = v.lstrip(".-_")
    return v or "1"


def sanitize_rel(r: str) -> str:
    """pkgrel 规范化为 makepkg 要求的 integer[.integer];
    ubuntu 后缀(如 2ubuntu1)转成 2.1, 其余非数字字符丢弃"""
    r = r.strip()
    m = re.match(r"^(\d+)", r)
    if not m:
        return "1"
    main = m.group(1)
    rest = r[m.end():]
    mm = re.search(r"(\d+)", rest)
    sub = mm.group(1) if mm else ""
    return main + ("." + sub if sub else "")

# ---------------------------------------------------------------------------
# ar 归档解析 (用于 .deb)
# ---------------------------------------------------------------------------

def parse_ar(path: str) -> List[Tuple[str, bytes]]:
    data = open(path, "rb").read()
    if data[:8] != b"!<arch>\n":
        raise ValueError("不是合法的 ar 归档 (deb?)")
    members = []
    pos = 8
    while pos + 60 <= len(data):
        hdr = data[pos:pos + 60]
        name = hdr[0:16].decode("latin1").rstrip()
        name = name.rstrip("/")
        size = int(hdr[48:58].decode("latin1").split()[0])
        body = data[pos + 60: pos + 60 + size]
        members.append((name, body))
        pos += 60 + size
        if pos & 1:
            pos += 1
    return members

# ---------------------------------------------------------------------------
# bsdtar 封装
# ---------------------------------------------------------------------------

def bsdtar_extract(archive: str, dest: str, exclude_prefixes: List[str] = None):
    if not which("bsdtar"):
        die("缺少 bsdtar (libarchive), 请先安装: sudo pacman -S libarchive")
    os.makedirs(dest, exist_ok=True)
    cmd = ["bsdtar", "-xf", archive, "-C", dest]
    for ex in (exclude_prefixes or []):
        cmd += ["--exclude", ex]
    run(cmd)


def bsdtar_list(archive: str) -> List[str]:
    out = run(["bsdtar", "-tf", archive])
    return [ln for ln in out.stdout.decode("utf8", "replace").splitlines() if ln.strip()]

# ---------------------------------------------------------------------------
# cpio(newc) 解析 — 用于 RPM payload, 纯 Python
# ---------------------------------------------------------------------------

CPIO_MAGIC = (b"070701", b"070702")


class CpioEntry:
    __slots__ = ("mode", "filepath", "target", "data", "islnk", "isdir", "isreg")


def extract_cpio_newc(stream, destdir: str):
    """stream: 已解压的二进制流. 按条目解到 destdir (绝对路径防穿越)"""
    count = 0
    while True:
        hdr = stream.read(110)
        if len(hdr) < 110:
            break
        if hdr[:6] not in CPIO_MAGIC:
            raise ValueError(f"非法 cpio 头: {hdr[:6]!r}")
        f = [int(hdr[6 + i * 8: 6 + (i + 1) * 8], 16) for i in range(13)]
        (_ino, mode, _uid, _gid, _nlink, _mtime, filesize,
         _devmaj, _devmin, _rmaj, _rmin, namesize, _chk) = f
        name = stream.read(namesize - 1).decode("utf8", "replace")
        stream.read(1)  # NUL
        pad = (110 + namesize) & 3
        if pad:
            stream.read(4 - pad)
        data = stream.read(filesize)
        pad = filesize & 3
        if pad:
            stream.read(4 - pad)
        if name == "TRAILER!!!":
            break
        # 防路径穿越
        name = name.lstrip("./")
        if not name or ".." in name.split("/"):
            continue
        target = os.path.join(destdir, name)
        ftype = mode & 0o170000
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if ftype == 0o040000:                       # 目录
            os.makedirs(target, exist_ok=True)
        elif ftype == 0o120000:                     # 符号链接
            linkto = data.decode("utf8", "replace")
            if os.path.lexists(target):
                os.remove(target)
            os.symlink(linkto, target)
        elif ftype == 0o100000:                     # 普通文件
            with open(target, "wb") as fp:
                fp.write(data)
            # 恢复权限位 (去掉高位类型位)
            try:
                os.chmod(target, mode & 0o7777)
            except OSError:
                pass
        else:                                        # 设备/管道/套接字: 忽略
            log.verb(f"跳过非常规 cpio 条目: {name} (type={oct(ftype)})")
        count += 1
    return count


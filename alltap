def _rpm_entry_value(typ, cnt, off, store):
    """按 rpm tag 类型从 store 中读取值 (offset 由 writer 按类型对齐)

    Read a value from the rpm header store according to its tag type
    (offset is aligned by the writer per type).
    """
    if typ in (6, 8, 9):    # STRING / STRING_ARRAY / I18NSTRING
        vals = []
        p = off
        n = 1 if typ == 6 else cnt
        for _ in range(n):
            e = store.find(b"\0", p)
            vals.append(store[p:e].decode("utf8", "replace"))
            p = e + 1
        return vals[0] if typ == 6 else vals
    if typ == 1:
        return store[off:off + cnt]
    if typ == 2:   # CHAR / int8
        return list(store[off:off + cnt])
    if typ == 3:
        return list(struct.unpack(f">{cnt}h", store[off:off + cnt * 2]))
    if typ == 4:
        return list(struct.unpack(f">{cnt}i", store[off:off + cnt * 4]))
    if typ == 5:
        return list(struct.unpack(f">{cnt}q", store[off:off + cnt * 8]))
    if typ == 7:   # BIN
        return store[off:off + cnt]
    raise ValueError(f"未知 rpm tag 类型 {typ}")


class RpmInfo:
    """RPM 解析结果: 元数据字段 + 按需解包的 payload 回调.

    f 的键是数字 tag (见 RPM_TAGS), 值已按 tag 类型解码为 str/int list/bytes.
    payload_to 不预先解包, 只有真正需要文件树时才调用, 避免纯元数据场景的空开销.

    RPM parse result: metadata fields plus a lazy payload extraction callback.

    f maps numeric tags (see RPM_TAGS) to decoded values. payload_to is only called
    when the file tree is actually needed, avoiding work for metadata-only use.
    """

    def __init__(self, fields, payload_to, compressor):
        self.f = fields                       # {tag号: 值}
                                              # {tag number: value}
        self.payload_to = payload_to          # callable(dest) -> 解出文件数量
                                              # callable(dest) -> number of extracted files
        self.compressor = compressor


def parse_rpm(path: str) -> RpmInfo:
    """纯 Python 解析 RPM: lead(96) + 签名 header + 主 header + 压缩 cpio payload.

    结构要点:
      * 开头 4 字节 \\xed\\xab\\xee\\xdb 是 lead magic, lead 长度固定 96;
      * 紧接着是签名 header, 其后的主 header 必须按"绝对文件偏移"8 字节对齐
        (注意不是相对偏移 — 这是 rpm 格式的一个坑);
      * header = 8 字节 magic + nindex/hsize + nindex×16 字节索引表 + hsize 字节存储区,
        索引表里的 offset 是相对存储区起点的偏移;
      * payload 从主 header 末尾一直延伸到文件末尾, 压缩方式由 PAYLOADCOMPRESSOR 决定.

    实现只把 header 读进内存, payload 按需从文件流式解压 (可处理数百 MB 的 RPM).

    Pure-Python RPM parser: lead(96) + signature header + main header + compressed cpio payload.

    Layout notes:
      * the first 4 bytes \xed\xab\xee\xdb are the lead magic; the lead is 96 bytes;
      * the main header must be aligned to 8 bytes by ABSOLUTE file offset
        (not relative) after the signature header — a classic rpm pitfall;
      * header = 8-byte magic + nindex/hsize + nindex x 16-byte index table + hsize store;
        offsets in the index table are relative to the start of the store;
      * the payload runs from the end of the main header to EOF; PAYLOADCOMPRESSOR
        selects the decompressor.

    Only headers are held in memory; the payload is streamed from disk, so very
    large RPMs are handled without loading them whole.
    """

    def read_header_at(fh) -> Tuple[list, bytes, int]:
        """从当前文件位置读一个 rpm header, 返回 (索引表, 存储区, 读取后的偏移).

        Read one rpm header from the current file position; returns
        (index table, store, offset after reading).
        """
        hdr = fh.read(16)
        # rpm 4.24+ 尾部 version/reserved 字节有差异, 只校验前 4 字节
        # rpm 4.24+ differs in trailing version/reserved bytes; validate the first 4 bytes only
        if len(hdr) < 16 or hdr[:4] != b"\x8e\xad\xe8\x01":
            raise ValueError("非法 RPM header magic")
        nindex, hsize = struct.unpack(">II", hdr[8:16])
        raw = fh.read(nindex * 16)
        if len(raw) < nindex * 16:
            raise ValueError("RPM header 索引表截断")
        entries = []
        for i in range(nindex):
            tag, typ, off, cnt = struct.unpack(">IIII", raw[i * 16:(i + 1) * 16])
            entries.append((tag, typ, off, cnt))
        store = fh.read(hsize)
        if len(store) < hsize:
            raise ValueError("RPM header 存储区截断")
        return entries, store, fh.tell()

    with open(path, "rb") as fh:
        lead = fh.read(96)
        if len(lead) < 96 or lead[:4] != b"\xed\xab\xee\xdb":
            raise ValueError("非法 RPM lead magic")
        # 签名 header 后按 8 字节(绝对文件偏移)对齐到主 header
        # the main header is aligned to 8 bytes by absolute file offset after the signature header
        _se, _ss, spos = read_header_at(fh)
        fh.seek((8 - (spos % 8)) % 8, os.SEEK_CUR)
        entries, store, payload_off = read_header_at(fh)

    fields = {}
    for (tag, typ, off, cnt) in entries:
        try:
            fields[tag] = _rpm_entry_value(typ, cnt, off, store)
        except Exception as e:
            log.verb(f"rpm tag {tag} 解析失败: {e}")

    compressor = fields.get(T["PAYLOADCOMPRESSOR"], "gzip")

    def payload_to(dest: str) -> int:
        """按 PAYLOADCOMPRESSOR 选择解压器, 再交给 cpio newc 解析器.

        gzip/xz/bzip2 走标准库; zstd 标准库没有, 只能调 zstd 命令.
        整条链路都是流式的, 不会把 payload 一次性载入内存.

        Choose a decompressor per PAYLOADCOMPRESSOR, then hand it to the cpio newc parser.

        gzip/xz/bzip2 use the standard library; zstd has no stdlib support and requires
        the zstd command. The whole chain is streamed and never loads the payload whole.
        """
        with open(path, "rb") as pf:
            pf.seek(payload_off)
            if compressor == "gzip":
                return extract_cpio_newc(gzip.GzipFile(fileobj=pf), dest)
            if compressor in ("xz", "lzma"):
                return extract_cpio_newc(lzma.LZMAFile(pf), dest)
            if compressor == "bzip2":
                return extract_cpio_newc(bz2.BZ2File(pf), dest)
            if compressor.startswith("zstd"):
                if not which("zstd"):
                    die("RPM payload 为 zstd 压缩, 需要 zstd 工具")
                proc = subprocess.Popen(["zstd", "-dc"], stdin=pf, stdout=subprocess.PIPE)
                try:
                    count = extract_cpio_newc(proc.stdout, dest)
                finally:
                    proc.stdout.close()
                if proc.wait() != 0:
                    raise ValueError("zstd 解压 RPM payload 失败")
                return count
            die(f"不支持的 RPM payload 压缩: {compressor}")

    return RpmInfo(fields, payload_to, compressor)


# rpm 依赖 flags (rpmds.h)
# rpm dependency flags (rpmds.h)
RPMSENSE_LESS, RPMSENSE_GREATER, RPMSENSE_EQUAL = 2, 4, 8


def rpm_sense_to_op(flags: int) -> Optional[str]:
    """把 rpm 依赖 flags 低 4 位翻译成比较符.

    rpmds.h 里 LESS=2, GREATER=4, EQUAL=8, 可组合:
      2 -> <, 4 -> >, 8 -> =, 2|8 -> <=, 4|8 -> >=
      2|4 (=<>) 是区间约束, pacman 无法表达, 退化为"无版本".

    Translate the low 4 bits of rpm dependency flags into a comparison operator.

    rpmds.h: LESS=2, GREATER=4, EQUAL=8; combinable as 2|8 (<=), 4|8 (>=).
    2|4 (<>) is a range that pacman cannot express and degrades to unversioned.
    """
    s = flags & 0xF
    if s == RPMSENSE_EQUAL:
        return "="
    if s == RPMSENSE_LESS:
        return "<"
    if s == RPMSENSE_GREATER:
        return ">"
    if s == (RPMSENSE_LESS | RPMSENSE_GREATER):
        return None   # <> 范围, pacman 无法表达, 视作无版本
                      # <> range cannot be expressed by pacman; treat it as unversioned
    if s == (RPMSENSE_LESS | RPMSENSE_EQUAL):
        return "<="
    if s == (RPMSENSE_GREATER | RPMSENSE_EQUAL):
        return ">="
    return None

